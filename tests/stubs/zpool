#!/bin/sh
echo "zpool $*" >> "${STUB_LOG:-/dev/null}"
case "$1" in
    list)
        # Real "not imported yet" by default - attempt_pool_import()'s
        # own "already imported, skip the real import" guard (see its
        # comment in init/init) needs this to genuinely fail here so
        # every test relying on the real "zpool import -f -N -d /dev
        # $POOL" line actually running still sees it. Set
        # STUB_ZPOOL_ALREADY_IMPORTED=1 for a test that specifically
        # wants the already-imported path instead.
        if [ "${STUB_ZPOOL_ALREADY_IMPORTED:-}" = "1" ]; then
            echo pool
            exit 0
        fi
        exit 1
        ;;
    get)
        echo "${STUB_BOOTFS:--}"
        ;;
    status)
        echo "${STUB_POOL_HEALTH:-pool is healthy}"
        ;;
    export)
        if [ "${STUB_ZPOOL_EXPORT_FAIL:-}" = "1" ]; then
            echo "cannot export '$2': pool is busy" >&2
            exit 1
        fi
        ;;
esac
exit 0
