#!/bin/sh
# zfs-unlock ACTION ENCRYPTIONROOT - the CLI entry point menu.py shells
# out to for its "Unlock encrypted root"/"Lock encrypted root" actions,
# so there is exactly one real implementation of the secret-acquisition/
# staging/locking logic (zfs-unlock.sh, sourced below), not a second one
# reimplemented in Python - see that file's own header comment for the
# full reasoning (a real, reported gap: menu.py's own bare `zfs
# load-key` used to unlock a dataset without ever staging a kexec
# handoff secret).
#
# boot-dataset.sh sources zfs-unlock.sh directly instead of exec'ing
# THIS file - it already has its own encryptionroot/DATASET/ROOTFS
# context and calls zfs_unlock()/zfs_lock() in-process, same reasoning
# as it already sources rescue-ssh.sh/net-config.sh directly rather
# than shelling out to them.
set -u
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

ACTION="${1:?usage: zfs-unlock (unlock|lock) ENCRYPTIONROOT}"
ENCRYPTIONROOT="${2:?usage: zfs-unlock (unlock|lock) ENCRYPTIONROOT}"

# Same real-boot-vs-test-harness path resolution as every other file in
# this project that needs to find its own siblings (see /init's own
# RESCUE_LIB_DIR comment for the full reasoning).
_src="${BASH_SOURCE:-$0}"
case "$_src" in
    */*) _dir="${_src%/*}"; _dir="${_dir:-/}" ;;
    *)   _dir="." ;;
esac
LIB_DIR="$(cd "$_dir" && pwd)"

# zfs_op_lock() (in zfs-unlock.sh) needs _pid_alive to reclaim a stale
# lock - boot-dataset.sh's own call path gets it transitively by
# sourcing rescue-ssh.sh first, but this standalone wrapper never
# sources rescue-ssh.sh at all, so it needs this explicitly.
. "$LIB_DIR/pid-alive.sh"
. "$LIB_DIR/zfs-unlock.sh"

# Unlike boot-dataset.sh, this standalone wrapper has no trap of its
# own to conflict with - registers zfs-unlock.sh's own
# _zfs_unlock_cleanup_tempfiles() directly (see that function's own
# comment for what it cleans up and why this file, not zfs-unlock.sh
# itself, is the one that binds it as a trap). Closes a real gap a full
# source audit found: an interrupt (Ctrl-C, a dropped SSH session) of
# THIS specific entry point - menu.py's own "Unlock encrypted root"
# action - mid-prompt used to leave the operator's plaintext passphrase
# sitting in one of two mktemp files in tmpfs for the rest of the
# rescue session, with nothing here to ever clean it up.
trap _zfs_unlock_cleanup_tempfiles EXIT INT TERM HUP

case "$ACTION" in
    unlock) zfs_unlock "$ENCRYPTIONROOT" ;;
    lock)   zfs_lock "$ENCRYPTIONROOT" ;;
    *)
        echo "zfs-unlock: unknown action '$ACTION' (expected unlock|lock)" >&2
        exit 2
        ;;
esac
