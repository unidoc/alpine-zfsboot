#
# alpine-zfsboot's own dialog config - genuinely monochrome
# (use_colors = OFF below), not just "we stopped pointing DIALOGRC at
# a theme". An earlier version of this project shipped a green-on-
# black color theme here instead, and real user feedback on real
# hardware was that it rendered corrupted over a real serial
# connection. Simply removing menu.py's own `DIALOGRC` env var did
# NOT fix that (confirmed the hard way, after real hardware kept
# showing the exact same green/corrupt rendering even with that env
# var gone): dialog's own compile-time GLOBALRC - which is this exact
# path, /etc/dialogrc, on Alpine same as virtually every other distro
# - is consulted whenever DIALOGRC and $HOME/.dialogrc aren't set,
# so as long as build.sh kept copying a colored theme here, dialog
# kept loading it regardless of the env var. This file is what
# actually governs dialog's rendering now - use_colors = OFF makes
# that true black-and-white regardless of what dialog's own built-in
# default would otherwise have been (which is itself a color scheme,
# not black-and-white), and regardless of any future DIALOGRC/
# $HOME/.dialogrc omission mistake repeating this same bug.
#
# Run-time configuration file for dialog
#
# Types of values:
#
# Number     -  <number>
# String     -  "string"
# Boolean    -  <ON|OFF>
# Attribute  -  (foreground,background,highlight?,underline?,reverse?)

# Set aspect-ratio.
aspect = 0

# Set separator (for multiple widgets output).
separate_widget = ""

# Set tab-length (for textbox tab-conversion).
tab_len = 0

# Make tab-traversal for checklist, etc., include the list.
visit_items = OFF

# Show scrollbar in dialog boxes?
use_scrollbar = OFF

# Shadow dialog boxes? Off - shadow boxes need precise, overlapping
# cursor positioning to draw correctly, exactly the kind of rendering
# that garbles if any byte gets delayed or dropped in transit, which a
# real serial link is far more exposed to than a local vga
# framebuffer. Confirmed as a real, if partial, contributor on real
# hardware before the actual GLOBALRC root cause (see above) was
# found.
use_shadow = OFF

# Turn color support OFF - this is the actual fix for the green theme
# that kept reappearing (see header comment above): no color
# attributes below are ever consulted while this is OFF, so their
# values are irrelevant, but dialog itself requires this file to
# remain syntactically complete.
use_colors = OFF

# Screen color
screen_color = (WHITE,BLACK,ON)

# Shadow color
shadow_color = (BLACK,BLACK,ON)

# Dialog box color
dialog_color = (WHITE,BLACK,ON)

# Dialog box title color
title_color = (WHITE,BLACK,ON)

# Dialog box border color
border_color = (WHITE,BLACK,ON)

# Active button color
button_active_color = (BLACK,WHITE,ON)

# Inactive button color
button_inactive_color = dialog_color

# Active button key color
button_key_active_color = button_active_color

# Inactive button key color
button_key_inactive_color = (WHITE,BLACK,OFF)

# Active button label color
button_label_active_color = (BLACK,WHITE,ON)

# Inactive button label color
button_label_inactive_color = (WHITE,BLACK,ON)

# Input box color
inputbox_color = dialog_color

# Input box border color
inputbox_border_color = dialog_color

# Search box color
searchbox_color = dialog_color

# Search box title color
searchbox_title_color = title_color

# Search box border color
searchbox_border_color = border_color

# File position indicator color
position_indicator_color = title_color

# Menu box color
menubox_color = dialog_color

# Menu box border color
menubox_border_color = border_color

# Item color
item_color = dialog_color

# Selected item color
item_selected_color = button_active_color

# Tag color
tag_color = title_color

# Selected tag color
tag_selected_color = button_label_active_color

# Tag key color
tag_key_color = button_key_inactive_color

# Selected tag key color
tag_key_selected_color = (BLACK,WHITE,ON)

# Check box color
check_color = dialog_color

# Selected check box color
check_selected_color = button_active_color

# Up arrow color
uarrow_color = (WHITE,BLACK,ON)

# Down arrow color
darrow_color = uarrow_color

# Item help-text color
itemhelp_color = (WHITE,BLACK,OFF)

# Active form text color
form_active_text_color = button_active_color

# Form text color
form_text_color = (WHITE,BLACK,ON)

# Readonly form item color
form_item_readonly_color = (WHITE,BLACK,ON)

# Dialog box gauge color
gauge_color = title_color

# Dialog box border2 color
border2_color = dialog_color

# Input box border2 color
inputbox_border2_color = dialog_color

# Search box border2 color
searchbox_border2_color = dialog_color

# Menu box border2 color
menubox_border2_color = dialog_color
