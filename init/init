#!/bin/sh
# alpine-zfsboot /init - PID 1 inside the boot initramfs.
#
# UEFI firmware -> this .EFI (busybox + zfs + kexec-tools + python3 +
# this script, bundled with a kernel via objcopy - see build.sh) ->
# this script -> zpool import -> read the pool's bootfs property ->
# menu.py: a dialog TUI, FreeBSD-loader-style - always shown, own
# countdown with the default entry pre-highlighted, auto-boots that
# entry if left alone, fully interactive if touched (boot-environment/
# kernel selection, BE lifecycle management, chroot, guided zfs-recv
# deployment, recovery shell - see that file). Console selection itself
# happens earlier, before any of this - see _boot_args_interrupt()'s
# own comment, further down.
#
# An earlier version of this project had a separate fast, Python-free
# automatic path for when no key was held, and only showed the menu on
# a keypress - a deliberate later choice moved to always showing the
# menu instead, matching FreeBSD's own loader more closely: one
# consistent first frame every boot, not two different experiences
# depending on whether a key happened to get pressed in time. The
# safety net this gave up (automatic boots never depending on Python)
# is covered instead by menu.py's own crash handling: any exception
# there falls back to running boot-dataset.sh directly, the exact same
# script the old automatic path called (see the bottom of this file).
set -u
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

# BusyBox's `reboot`/`halt`/`poweroff`, called WITHOUT their own -f
# flag, don't touch the kernel themselves at all - they signal PID 1
# (SIGTERM/SIGUSR1/SIGUSR2 respectively, the same convention real
# sysvinit's own init(8) documents) and expect PID 1 to run an orderly
# shutdown sequence and perform the actual reboot(2)/poweroff itself.
# This script - PID 1 for this entire initramfs - never had a handler
# for any of those signals, so a bare `reboot` here was a real,
# reported no-op: the signal arrived, nothing was listening for it,
# nothing happened. `poweroff -f` "worked" only because -f bypasses
# PID 1 entirely and calls the reboot(2) syscall directly.
#
# Forcing here (the exact same reboot(2)/poweroff -f these signals
# would otherwise expect PID 1 to eventually call anyway) is correct
# for this specific environment, not a shortcut: there is no orderly
# shutdown sequence to run first (no services, no OpenRC runlevels, no
# mounted filesystems beyond what this script itself manages) - "force"
# is the only real shutdown this PID 1 was ever going to perform.
trap 'reboot -f' TERM
trap 'halt -f' USR1
trap 'poweroff -f' USR2

# ROOTFS is empty at real boot (this script IS pid 1 in a fresh
# initramfs - /etc, /root, /proc are really at those absolute paths,
# nothing else could be mounted over them yet) - so every "$ROOTFS/..."
# below is byte-identical to the bare path there. It only becomes
# non-empty under tests/run-tests.sh, which sets STUB_ROOT to a scratch
# directory so tests can never write into this dev machine's real
# /etc/passwd or /root/.ssh.
ROOTFS="${STUB_ROOT:-}"

# Where net-config.sh/rescue-ssh.sh actually live: `/` at a real boot
# (build.sh copies them there, alongside this file itself, /menu.py,
# /boot-dataset.sh) - but under tests/run-tests.sh, this file is
# dot-sourced from its OWN repo path ($REPO_ROOT/init/init), not run as
# a standalone /init, so its sibling scripts live next to IT, not at a
# real `/`. ${BASH_SOURCE[0]:-$0} resolves correctly either way: bash
# (the test harness's own interpreter) keeps BASH_SOURCE[0] as the
# actual sourced file's real path regardless of $0; a real boot's own
# /bin/sh has no BASH_SOURCE array at all, where $0 is already exactly
# right (this script genuinely IS /init, run directly as pid 1, not
# sourced from anywhere).
# dirname(1) isn't in this initramfs's busybox applet set (confirmed on
# a real boot: "dirname: not found") - pure shell parameter expansion
# instead, with no external-binary dependency at all. A real boot's own
# $0 is exactly "/init" (single leading slash, no subdirectory) - the
# case "${_src%/*}" alone gets wrong ("" instead of "/") - handled
# explicitly below rather than assumed away.
_src="${BASH_SOURCE:-$0}"
case "$_src" in
    */*) _dir="${_src%/*}"; _dir="${_dir:-/}" ;;
    *)   _dir="." ;;
esac
RESCUE_LIB_DIR="$(cd "$_dir" && pwd)"

POOL="zroot"
MENU_TIMEOUT=2
# Real hardware found (Kimsufi/OVH-class bare metal, IPMI Serial-Over-
# LAN): the interactive countdown starts the instant menu.py reaches
# it, with no allowance for a remote console that hasn't finished
# re-attaching yet after this exact reboot - SOL sessions commonly take
# a few real seconds to relay data again post-reset. With a short
# alpine-zfsboot.timeout= (10s in the reported case), the whole
# countdown can elapse - silently auto-booting the default - before the
# operator's own viewer ever reconnects, which looks indistinguishable
# from "the menu never came up at all". menu.py's own main() pauses
# this many seconds, unconditionally, right before the real countdown
# starts (see its own comment) - configurable for the same reason
# MENU_TIMEOUT is: no single value is right for every BMC/console.
MENU_GRACE=5

# How long _boot_args_interrupt() (see its own comment, further down)
# waits for a bare TAB keypress before giving up and continuing the
# unattended boot untouched - every registered console gets this full
# window CONCURRENTLY (see _boot_args_wait_for_tab()'s own comment), not
# one window divided or multiplied across them, so this number is the
# real, exact wall-clock delay added to every boot regardless of how
# many consoles are registered. 15s, not a few seconds: a remote console
# (VNC/BMC/IPMI) needs several seconds to attach - the same class of
# latency MENU_GRACE above exists to absorb.
BOOT_ARGS_TIMEOUT=15

msg() {
    echo "alpine-zfsboot: $*" > /dev/kmsg 2>/dev/null
    echo "$*"
}

# Never `set -e` here: a failed step must explain itself and drop to a
# shell, not panic the kernel or silently reboot-loop.
die() {
    msg "FATAL: $*"
    # Tells every OTHER registered/relevant console (not wherever this
    # process's own stdio actually is) that the recovery shell is
    # elsewhere, not here - see _notify_recovery_shell_elsewhere()'s own
    # comment, further down, for why this is a DIFFERENT message there
    # rather than the same one repeated everywhere. Defined later in
    # this file but always called long after the whole file (and every
    # function in it) has already been read - safe regardless of
    # definition order, same as every other forward-reference in this
    # script.
    _notify_recovery_shell_elsewhere
    # One of this project's three rescue-ssh trigger points (see
    # rescue-ssh.sh's own header comment) - a bare recovery shell with
    # no menu.py/UI running is exactly the "no local recourse short of
    # already knowing the right incantations" case remote SSH access
    # exists for. No-ops cleanly if no authorized_keys/host key were
    # ever staged for this boot (start_rescue_ssh's own first guard).
    start_rescue_ssh
    msg "dropping to a recovery shell (bash)"
    _recovery_shell
}

# _recovery_shell/_recovery_shell_child - give the operator a real,
# working emergency shell. Same design, same reasoning, as
# boot-dataset.sh's OWN identical pair of functions (this file has no
# way to share code with a separate process's own script, so it's
# duplicated rather than sourced - see that file's own header comment
# for the full story, including why `cttyhack` was removed and replaced
# with a directly-verified `setsid -c` instead, and why PID 1 never
# execs straight into either of these).
#
# This file (unlike boot-dataset.sh) genuinely IS always PID 1 at the
# point die() is ever called on a real boot - it is /init's own
# function, called only before /init has exec'd into anything else.
# The `[ "$$" -eq 1 ]` check below is still needed anyway, purely so
# tests/run-tests.sh (which dot-sources this file under its OWN,
# never-1 pid - see run_stubbed()) can exercise the not-PID-1 branch
# instead of hanging this test suite forever in a real fork+wait loop.
_recovery_shell() {
    export PS1='\[\e[1;32m\]alpine-zfsboot\[\e[0m\] \w # '
    if [ -n "$ROOTFS" ]; then
        if [ "$$" -eq 1 ]; then
            msg "TEST STUB: would fork a recovery shell and wait forever (pid 1)"
        elif ( : < /dev/tty ) 2>/dev/null; then
            msg "TEST STUB: would exec /bin/bash directly (already has a controlling terminal)"
        else
            msg "TEST STUB: would exec setsid -c /bin/bash (no controlling terminal yet)"
        fi
        # `exit`, not `return` - every real call site below this point
        # is an `exec` that never returns to its own caller (the whole
        # point of a recovery/emergency shell). A plain `return` here
        # would instead let the REST of this script's top-level code
        # keep running right past whatever called this - a real,
        # confirmed regression the first version of this test stub
        # caused (a test staged for "encryption key never loads" ended
        # up mounting and kexec'ing an unrelated kernel anyway, because
        # returning from here just fell through to unrelated code
        # further down the script).
        exit 0
    fi
    if [ "$$" -eq 1 ]; then
        # PID 1 must NEVER exit - see _recovery_shell_child's own
        # comment for exactly why `exec`-ing straight into this (as the
        # old `exec setsid cttyhack /bin/bash` did) is a real kernel-
        # panic hazard specifically for PID 1. Forking instead means
        # PID 1 keeps running as the loop below for as long as this
        # whole initramfs lives, regardless of what the recovery shell
        # itself ever does - reboot/halt/poweroff still work from
        # inside it (the trap handlers at the top of this file fire on
        # PID 1 regardless of what PID 1 is currently blocked on).
        #
        # A fresh child every time around, not one child forked once
        # outside the loop - `wait` with no pid argument, once no
        # children remain to reap, returns immediately rather than
        # blocking (POSIX), which would otherwise turn this into a
        # tight, permanent 100%-CPU busy-loop the instant the operator
        # exits that first shell. Waiting for a SPECIFIC pid blocks
        # correctly, and re-forking on every iteration means exiting
        # the shell (accidentally or on purpose) hands the operator a
        # brand new one instead of leaving PID 1 alive but permanently
        # stuck with no usable shell for the rest of this boot.
        #
        # A bug in this exact loop, confirmed
        # by direct reproduction (a real pty, real session leadership):
        # POSIX mandates that an asynchronous list's (a `&`-backgrounded
        # job's) standard input is forced to /dev/null UNLESS an
        # explicit redirection says otherwise - confirmed directly
        # (`busybox ash -c '( readlink /proc/self/fd/0 ) & wait' <
        # realfile` prints "/dev/null", not the real file) - meaning
        # `( _recovery_shell_child ) &` ALWAYS ran with stdin=/dev/null,
        # regardless of whatever real console this process's own fd 0
        # was actually connected to. `_recovery_shell_child`'s own
        # `exec /bin/bash` then inherited that same /dev/null stdin -
        # non-interactive, immediate EOF, instant exit - so this loop
        # was never actually a recovery shell on PID 1 at all: it was
        # an unthrottled fork-bomb silently re-launching and
        # immediately killing a non-interactive bash, as fast as
        # fork+exec allow, for the rest of the boot, with nothing ever
        # appearing on the console to explain why. Reproduced directly:
        # 10 iterations completed inside a 2-second window. `exec
        # 3<&0` duplicates THIS shell's own real fd 0 (whatever it's
        # actually connected to - already-established ctty or not;
        # unlike hardcoding `/dev/tty`, which can't even be opened
        # before a ctty exists) onto fd 3 once, here, before the loop
        # starts - the async-list override only ever touches fd 0
        # itself, never other inherited fds - so `<&3` on the
        # background job gives it back its own real input instead of
        # /dev/null. Confirmed by the same direct reproduction: real
        # keystrokes written to the pty were correctly read back by
        # the shell afterward.
        exec 3<&0
        while true; do
            ( _recovery_shell_child ) <&3 &
            wait "$!"
        done
    fi
    _recovery_shell_child
}

_recovery_shell_child() {
    if ( : < /dev/tty ) 2>/dev/null; then
        # Already has a controlling terminal - nothing to establish,
        # just use it (see menu.py's own _establish_controlling_terminal()
        # for the identical capability test and the same reasoning).
        exec /bin/bash
    fi
    # No controlling terminal yet - the real fresh-initramfs-PID1 case.
    # `cttyhack` (a standard busybox applet built for exactly this) is
    # NOT compiled into this project's busybox - confirmed via
    # `strings`/applet-table inspection, not a PATH issue - meaning
    # this emergency shell had NEVER actually worked, locally or over
    # SSH, since it was first written (the visible symptom was always
    # "cttyhack: applet not found", silently swallowed by the shell
    # exiting). `setsid -c` (bare `setsid`, which resolves to the
    # busybox applet via this file's own `busybox --install` above, not
    # a coreutils binary) is used instead - confirmed by direct,
    # hands-on reproduction against this exact busybox version to
    # correctly claim an available-but-unclaimed pty as the new
    # child's own controlling terminal, and to never touch the calling
    # process's own session/tty state either way, in every scenario
    # tested.
    exec setsid -c /bin/bash
}

# mkinitfs's own stock /init (replaced entirely by ours via `mkinitfs
# -i`) normally does this - busybox ships in this image as a single
# multi-call binary with no per-applet symlinks baked into the cpio
# archive itself (confirmed against a real build: only /usr/bin/sh
# existed - no cat, mount, mdev, ls, anything else). Without this,
# every external command below except shell builtins silently fails
# to even be found - which is exactly what made zpool import look
# like it failed for a ZFS reason, when the real cause was `mount`/
# `mdev`/`cat` all being missing and /tmp never getting created.
/usr/bin/busybox --install -s /usr/bin

mkdir -p /tmp

mount -t proc     proc     /proc     2>/dev/null
mount -t sysfs    sysfs    /sys      2>/dev/null
mount -t devtmpfs devtmpfs /dev      2>/dev/null || mdev -s

# Last Boot Diagnostics, kernel-crash evidence - efi-pstore only, NOT
# ramoops (see temp/alpine-install-zfs.sh's own comment for the real-
# kernel-source research on why ramoops was rejected for this project:
# no stock-kernel, no-magic-address way to guarantee the writer and
# reader kernels agree on a physical RAM region, and its fixed-address
# fallback is x86-only, useless on the validated aarch64 Hetzner CAX
# hardware anyway).
#
# UEFI only: /sys/firmware/efi is the kernel's own authoritative,
# runtime-observable signal for "was this boot UEFI or legacy BIOS" -
# not something inferred from how this image was built, since the same
# shared kernel+initramfs boots either way. modprobe here loads THIS
# (rescue) kernel's own copy of the module - a separate boot/module
# state entirely from whatever the target kernel that may have panicked
# did; nothing here ever WRITES evidence, only reads what's already
# sitting in NVRAM from before.
#
# Capability is read from /sys/module/pstore/parameters/backend, not
# from mount success - CONFIG_PSTORE=y alone (Alpine's own kernel has
# this, built in) lets the pstore filesystem mount successfully with
# ZERO backend registered, so "did the mount succeed" proves nothing
# about whether real evidence could ever exist here. This was a real,
# adversarially-found bug in an earlier version of this feature: an
# operator would have been told "no evidence (clean boot)" on hardware
# where evidence could never have been captured in the first place -
# indistinguishable from an actually clean boot, which is exactly the
# kind of claim-from-silence this subsystem's "never claim a cause we
# didn't observe" rule also forbids.
#
# menu.py reads that sysfs file itself, live, at the point it's needed -
# NOT via an env var exported here. An earlier version did export one
# (ALPINE_ZFSBOOT_PSTORE_BACKEND), which was a SECOND real bug: dropbear's
# own clearenv() wipes every variable this file exports for a rescue-SSH
# session (see the ESP-persisted-material comment block above, and
# menu.py's own ACTIVE_TTY comment, for the same already-known problem) -
# a remote operator, the primary audience this whole feature exists for,
# would always have seen "unsupported" regardless of the real hardware
# state. Backend registration is a kernel-global fact, not something
# specific to this process - menu.py can just read it fresh, correctly,
# from any session, with no inheritance involved at all.
#
# Best-effort/fail-open like every other optional step in this file:
# legacy BIOS, a kernel that doesn't have the module bundled, or a
# mount failure all just leave that sysfs file empty/missing, which
# menu.py already renders as an honest "unavailable/unsupported" rather
# than an error.
if [ -d /sys/firmware/efi ]; then
    modprobe efi_pstore pstore_disable=0 2>/dev/null
fi
mkdir -p /sys/fs/pstore
mount -t pstore pstore /sys/fs/pstore 2>/dev/null

# `apk` is bundled here (see build.sh's own base.files reasoning) for
# real rescue-shell use, and `apk add openssh` is a real thing an
# operator does from there - confirmed the hard way: openssh refuses to
# start with "Privilege separation user sshd does not exist" until this
# exists. The installed system's own chroot script (alpine-install-
# zfs.sh) checks this the same way in spirit, via `getent passwd sshd`
# - not used here, since getent isn't a busybox applet at all (a real
# install needed `apk add musl-utils` for it - confirmed the hard way,
# same session) and this minimal initramfs has no such package manager
# step to fall back on. `grep` against /etc/passwd directly instead -
# already relied on elsewhere in this same file, no new dependency.
# Idempotent - safe unconditionally, costs nothing when nobody ever
# installs sshd.
grep -q '^sshd:' /etc/passwd 2>/dev/null || adduser -h / -s /sbin/nologin -S sshd 2>/dev/null
# devpts - confirmed missing the hard way on a real boot: menu.py's
# own countdown-activity relay (see its _run_dialog_with_activity())
# calls os.openpty() to give `dialog` a pty it fully controls, and
# without a real devpts filesystem mounted, that fails outright
# ("out of pty devices") - /dev/pts existing as a plain directory
# (from devtmpfs above) is not the same thing as a mounted devpts
# that can actually ALLOCATE a new pty pair through /dev/ptmx. menu.py
# survives this (falls back to automatic boot rather than a kernel
# panic - see its own top-level exception handler), but the menu never
# comes up at all without this.
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null

# Confirmed the hard way on real Proxmox/virtio-scsi hardware: a
# storage HBA module (virtio_scsi) loading successfully is NOT enough
# on its own to make a disk show up as /dev/sdX - that translation is
# a SEPARATE module (sd_mod, the generic SCSI disk class driver), and
# it normally only loads automatically via udev/mdev reacting to the
# new-device uevent the HBA driver's own probe raises. `mdev -s` two
# lines up is a one-shot STATIC scan of whatever /sys already looked
# like at that moment - it ran before any of these drivers had loaded
# a single device, so nothing was there yet to find, and nothing is
# listening for the later uevents that would normally trigger this.
# Loading everything explicitly sidesteps hotplug entirely rather
# than depending on infrastructure this minimal initramfs doesn't run.
# ata_piix/ahci cover real and virtualized SATA, nvme real/virtual
# NVMe, virtio_scsi/virtio_blk the two Proxmox VirtIO disk attachment
# choices, sd_mod/sr_mod the actual /dev/sd*|sr* node creation both
# SCSI-class paths (ata, virtio_scsi) depend on. virtio_net - confirmed
# missing the hard way on a real boot: the .ko is bundled (see
# build.sh's own alpine-zfsboot.modules list) but was never actually loaded
# here, so /dev/eth0 never existed at all and neither the automatic
# (rescue-ssh-triggered) nor the on-demand (menu.py's own Network item)
# DHCP bring-up had any interface to operate on - same class of gap as
# the storage modules above, just never hit until something actually
# needed the network.
#
# virtio_mmio - same class of gap again, confirmed the hard way on a
# real Hetzner Cloud ARM64 (CAX) boot: virtio_pci (below) only covers
# PCI-transport virtio devices, but QEMU's aarch64 "virt" machine type
# (what Hetzner Cloud's ARM64 line uses) exposes virtio devices over
# MMIO instead of PCI by default. Without virtio_mmio loaded first,
# virtio_blk/virtio_scsi/virtio_net/virtio_gpu have no actual bus to
# probe against and never attach to anything, silently - a working
# reference Alpine install on the exact same platform force-loads this
# via its own GRUB `modules=virtio_mmio,...` cmdline for exactly this
# reason. Listed first (alongside virtio_pci), before anything that
# binds to a device the transport exposes, same ordering reasoning as
# the rest of this list. virtio_gpu - the actual display device on
# this same platform (the "Display output is not active" symptom this
# was chasing): bundled via build.sh's own "virtio" mkinitfs feature
# (features.d/virtio.modules upstream ships kernel/drivers/gpu/drm/
# virtio) but - same historical mistake as virtio_net above - bundling
# the .ko is not the same as loading it, and nothing here ever did.
# xhci_hcd/xhci_pci/ehci_hcd/ehci_pci/usbhid/hid_generic/usbkbd/
# virtio_input - the other half of the real "display output not active"
# root cause on Hetzner CAX (build.sh's own CONSOLE_CMDLINE comment has
# the full story): confirmed via a real boot's own /proc/bus/input/
# devices that no driver had bound the emulated USB keyboard at all.
for mod in virtio_mmio virtio_pci virtio_gpu virtio_net virtio_blk virtio_scsi ahci ata_piix nvme sd_mod sr_mod \
           xhci_hcd xhci_pci ehci_hcd ehci_pci usbhid hid_generic usbkbd virtio_input; do
    modprobe "$mod" 2>/dev/null
done

# alpine-zfsboot.pool=/alpine-zfsboot.timeout= and this same boot's
# network/rescue-ssh options are this project's own cmdline options,
# baked into the .cmdline section build.sh writes into the EFI bundle
# (or, for the network/ssh.* ones below, just as plausibly supplied
# per-boot by whatever's actually booting this - a hosting provider's
# own kernel-cmdline override, GRUB menu edit, etc) - not Alpine's
# KOPT_* convention (that belongs to mkinitfs's own stock init, which
# this script replaces entirely via `mkinitfs -i`, so there's no
# KOPT_* parser left to piggyback on).
#
# Rescue SSH itself has no cmdline option at all anymore - who may
# connect (authorized_keys) and this machine's own persistent identity
# (ssh_host_ed25519_key) are ordinary files on the ESP, found by the
# same discovery pass as the config file below, not another key=value
# grammar - see rescue-ssh.sh's own header comment for the full
# reasoning (an earlier alpine-zfsboot.ssh_key=<base64 pubkey> cmdline
# key existed here; removed rather than kept alongside the ESP files as
# a second mechanism for the same thing).
ALPINE_ZFSBOOT_NET=""
ALPINE_ZFSBOOT_IPV4=""
ALPINE_ZFSBOOT_IPV4_ADDRESS=""
ALPINE_ZFSBOOT_IPV4_GATEWAY=""
ALPINE_ZFSBOOT_IPV6=""
ALPINE_ZFSBOOT_IPV6_ADDRESS=""
ALPINE_ZFSBOOT_IPV6_GATEWAY=""
ALPINE_ZFSBOOT_SSH_LISTEN=""
ALPINE_ZFSBOOT_SSH_PORT=""
ALPINE_ZFSBOOT_SSH_ALLOW=""
# alpine-zfsboot.net.mac= - the MAC address of the network card the rescue
# network uses instead of eth0 (net-config.sh's net_resolve_iface). Empty:
# eth0, exactly as before this key existed.
ALPINE_ZFSBOOT_NET_MAC=""
# bootcheck (failed-boot detection - see boot-dataset.sh's own
# "content-derived arming" comment for the full design) and
# panic_timeout (general boot policy, deliberately independent of
# bootcheck - see its own case arm below for why) - both empty by
# default, meaning "no override", not "off"/"0": an empty
# ALPINE_ZFSBOOT_BOOTCHECK does not disable the per-BE ZFS property
# gate, and an empty ALPINE_ZFSBOOT_PANIC_TIMEOUT falls back to this
# project's own conservative default rather than 0 - see boot-
# dataset.sh's own handling for why "unset" and "explicitly 0" must
# stay distinguishable.
ALPINE_ZFSBOOT_BOOTCHECK=""
ALPINE_ZFSBOOT_BOOTCHECK_MAX=""
ALPINE_ZFSBOOT_PANIC_TIMEOUT=""
# ESP device found during discovery further down - empty by default,
# not just left undeclared (F22, unidoc-alip's PR #5 review): this is
# only ever export'd once exactly one ESP candidate qualifies, so on
# any OTHER machine (zero or more than one candidate - refused-to-
# guess is a real, supported outcome, not just a startup-order
# accident) it's never set at all, and read_fat_console_pref()'s own
# `[ -n "$ALPINE_ZFSBOOT_ESP_DEV" ]` check - which already correctly
# treats "empty" as "nothing to do, return" - hit a hard "parameter
# not set" abort under this file's own `set -u` instead, on every
# select_console() call on such a machine.
ALPINE_ZFSBOOT_ESP_DEV=""
# FAT UUID and MEMBER install id of that ESP (esp-select.sh), for the
# post-import pool identity cross-check and for rescue diagnostics.
ALPINE_ZFSBOOT_ESP_UUID=""
ALPINE_ZFSBOOT_ESP_INSTALL_ID=""
# Last successfully read persisted console (see read_fat_console_pref()).
_CONSOLE_PREF_CACHE=/tmp/alpine-zfsboot-console-pref.cache
# Persisted console choice (see select_console()'s own comment for the
# full mechanism) - empty means "no persisted preference", not "tty0
# specifically"; select_console()'s own kernel-reported default still
# applies in that case.
# Cmdline-only (never set from the persisted config file - see
# select_console()'s own header comment for why that layer is read
# fresh at use-time instead of captured here).
ZFSBOOT_CONSOLE_CMDLINE=""
# Sourced-based routing for the ONE key (console=) that needs to know
# which of apply_zfsboot_kv()'s two callers (the config-file loop, or
# the /proc/cmdline loop) it's being invoked from - see that key's own
# case-arm comment. Every other key in that function is fine with
# plain last-write-wins regardless of source, so this is deliberately
# not a general mechanism, just what this one key actually needs.
ZFSBOOT_KV_SOURCE=""

# Single source of truth for the alpine-zfsboot.* cmdline vocabulary -
# fed both by the ESP-persisted config below and by /proc/cmdline
# itself, in that order, so a single case statement (not two
# copy-pasted ones that could drift) defines what a valid key is.
apply_zfsboot_kv() {
    # Strip a trailing CR - confirmed a real risk, not hypothetical: the
    # ESP is FAT, and FAT-formatted config files get edited from
    # Windows/from rescue tooling/from anything, any of which can leave
    # CRLF line endings. Without this, alpine-zfsboot.ipv6.gateway=fe80::1
    # (with a trailing \r) becomes a gateway value with a CR stuck to the
    # end - `ip -6 route add default via $'fe80::1\r' dev eth0` then
    # fails with a message that looks like an unrelated problem, on a
    # machine nobody can see. Cmdline tokens are already word-split by
    # the kernel and never carry a stray CR, so this is a no-op there -
    # safe to apply unconditionally rather than only in the ESP-config
    # reading loop.
    kv="${1%$(printf '\r')}"
    case "$kv" in
        alpine-zfsboot.pool=*) POOL="${kv#alpine-zfsboot.pool=}" ;;
        alpine-zfsboot.timeout=*) MENU_TIMEOUT="${kv#alpine-zfsboot.timeout=}" ;;
        alpine-zfsboot.menu_grace=*) MENU_GRACE="${kv#alpine-zfsboot.menu_grace=}" ;;
        alpine-zfsboot.interrupt_timeout=*) BOOT_ARGS_TIMEOUT="${kv#alpine-zfsboot.interrupt_timeout=}" ;;
        alpine-zfsboot.net=*) ALPINE_ZFSBOOT_NET="${kv#alpine-zfsboot.net=}" ;;
        alpine-zfsboot.ipv4.address=*) ALPINE_ZFSBOOT_IPV4_ADDRESS="${kv#alpine-zfsboot.ipv4.address=}" ;;
        alpine-zfsboot.ipv4.gateway=*) ALPINE_ZFSBOOT_IPV4_GATEWAY="${kv#alpine-zfsboot.ipv4.gateway=}" ;;
        alpine-zfsboot.ipv4=*) ALPINE_ZFSBOOT_IPV4="${kv#alpine-zfsboot.ipv4=}" ;;
        alpine-zfsboot.ipv6.address=*) ALPINE_ZFSBOOT_IPV6_ADDRESS="${kv#alpine-zfsboot.ipv6.address=}" ;;
        alpine-zfsboot.ipv6.gateway=*) ALPINE_ZFSBOOT_IPV6_GATEWAY="${kv#alpine-zfsboot.ipv6.gateway=}" ;;
        alpine-zfsboot.ipv6=*) ALPINE_ZFSBOOT_IPV6="${kv#alpine-zfsboot.ipv6=}" ;;
        # Validated and resolved only when the rescue network is actually
        # brought up (net-config.sh's net_resolve_iface) - a healthy boot
        # never waits for it, and a bad value cannot stop the pool boot.
        alpine-zfsboot.net.mac=*) ALPINE_ZFSBOOT_NET_MAC="${kv#alpine-zfsboot.net.mac=}" ;;
        # Mirrored boot (esp-select.sh): read from /proc/cmdline BEFORE the
        # ESP is chosen, and from the chosen ESP's own config by
        # esp-select.sh itself - nothing left to do here.
        alpine-zfsboot.esp-uuids=*) : ;;
        alpine-zfsboot.esp-self=*) : ;;
        alpine-zfsboot.ssh.listen=*) ALPINE_ZFSBOOT_SSH_LISTEN="${kv#alpine-zfsboot.ssh.listen=}" ;;
        alpine-zfsboot.ssh.port=*) ALPINE_ZFSBOOT_SSH_PORT="${kv#alpine-zfsboot.ssh.port=}" ;;
        alpine-zfsboot.ssh.allow=*) ALPINE_ZFSBOOT_SSH_ALLOW="${kv#alpine-zfsboot.ssh.allow=}" ;;
        # Raw candidate name (tty0/ttyS0/ttyS1/ttyS2/ttyAMA0), not
        # validated here - select_console() only ever applies this if it
        # matches one of THIS boot's real, present candidates, silently
        # ignoring anything else (a stale preference from a machine
        # that used to have a serial port it no longer does, for
        # instance) - the same "unset vs. explicitly wrong" pattern
        # every other optional key here already follows.
        #
        # Only captured here when it came from /proc/cmdline
        # (ZFSBOOT_KV_SOURCE=cmdline, set by that loop below) -
        # select_console()'s cmdline layer needs a single, stable,
        # boot-time value, unlike its config-file layer (which is read
        # fresh at use-time instead, straight off the ESP - nothing
        # inside the running menu writes to it anymore, but it can still
        # change out from under a long-running rescue session if an
        # operator hand-edits the ESP over rescue-SSH). A config-file
        # console= line still applies (this whole function is the
        # config-file's own parser too - see this function's own header
        # comment), it just does its job later, at read time, not here.
        alpine-zfsboot.console=*)
            [ "$ZFSBOOT_KV_SOURCE" = cmdline ] && ZFSBOOT_CONSOLE_CMDLINE="${kv#alpine-zfsboot.console=}"
            ;;
        # off: disable bootcheck gating/accounting entirely for this ONE
        # boot (no read, no increment, no gate) - a supervised
        # diagnostic boot. force: NOT "force-enable bootcheck" - it
        # means "once the attempt threshold is hit, stay in rescue even
        # if start_rescue_ssh itself fails to actually come up" (an
        # operator with local/IPMI console who deliberately wants the
        # machine to stop rather than keep silently retrying
        # unreachably). Documented here, not just in the design doc,
        # because this exact ambiguity was flagged during design review
        # as the one part of this API most likely to be misread.
        alpine-zfsboot.bootcheck=*) ALPINE_ZFSBOOT_BOOTCHECK="${kv#alpine-zfsboot.bootcheck=}" ;;
        alpine-zfsboot.bootcheck.max=*) ALPINE_ZFSBOOT_BOOTCHECK_MAX="${kv#alpine-zfsboot.bootcheck.max=}" ;;
        # Deliberately a SEPARATE key from bootcheck.* - general boot
        # policy (a headless physical machine sitting at a panic screen
        # forever is bad regardless of whether bootcheck is even in
        # use), not an implementation detail of the counter feature.
        # See boot-dataset.sh's own panic= injection for the "0 is a
        # legal, meaningful value" handling this needs downstream.
        alpine-zfsboot.panic_timeout=*) ALPINE_ZFSBOOT_PANIC_TIMEOUT="${kv#alpine-zfsboot.panic_timeout=}" ;;
        # cmd/tool-only build metadata (internal/cmdline/cmdline.go reads
        # these straight from the .cmdline PE section, offline, so it never
        # has to unpack an initramfs just to answer "what version is
        # this"). build.sh's own cmdline-assembly printf bakes BOTH of
        # these onto every single build's cmdline unconditionally -
        # confirmed a real, 100%-of-boots warning on real CAX hardware,
        # not a rare misconfiguration: `apply_zfsboot_kv()` had no case
        # arm for either, so both fell into the catch-all below and
        # printed "unrecognized option" on every normal boot. Neither is
        # operator config and neither is read by anything INSIDE the
        # booted environment (menu.py's own version/build-stamp display
        # reads separate flat files baked into the initramfs instead -
        # see build.sh's own /etc/alpine-zfsboot-version handling) - so
        # these are recognized, intentional no-ops here, not exclusions
        # from parsing: the whole cmdline is one opaque token stream to
        # this function, there is no other place to special-case them.
        alpine-zfsboot.version=*) : ;;
        alpine-zfsboot.buildstamp=*) : ;;
        # Read by the BIOS stage2 loader only (bios/stage2_main.c: prints
        # its E820/load-range/disk-read diagnostics when an operator adds
        # it to EFI/ALPINE/CMDLINE); nothing to do here, and no warning.
        alpine-zfsboot.diag=*) : ;;
        # Also stage2's own: the loaded-payload check's mode for this boot
        # (off|warn|enforce, see bios/payload_sum.h).
        alpine-zfsboot.integrity=*) : ;;
        # And stage2's INT 13h transfer cap (bios/disk.h).
        alpine-zfsboot.int13chunk=*) : ;;
        # Catches anything starting with the alpine-zfsboot. prefix that
        # didn't match one of the specific keys above (a typo, a
        # removed/renamed key, ipv6.gw instead of ipv6.gateway, ...) -
        # scoped to the prefix specifically so this does NOT fire for
        # every ordinary, unrelated cmdline token (root=, console=,
        # quiet, ...) that also flows through this same function from
        # the /proc/cmdline loop further down. The only signal this
        # feature has when something's wrong is "the box never came
        # up" - a loud warning here is near-zero risk and real value.
        alpine-zfsboot.*) msg "WARNING: unrecognized option $kv - ignored" ;;
    esac
}

# ESP-persisted material (/EFI/ALPINE/ on the EFI System
# Partition) - install-time, per-machine settings/material that must
# survive without baking anything per-machine into the shared .EFI
# binary (EXTRA_CMDLINE is build-time only, one shared artifact for the
# whole fleet - see build.sh). Three separate files with three separate
# jobs, deliberately not one grammar for all of it:
#   config                 - policy: network/bootcheck/ssh.*/console
#                             settings,
#                             read BEFORE /proc/cmdline below so cmdline
#                             always wins (a bad persisted config must
#                             stay overridable for one boot, never a
#                             permanent lock-out)
#   authorized_keys        - trust: who may connect - one BARE public
#                             key per line (blank lines/comments OK),
#                             NOT full OpenSSH authorized_keys syntax:
#                             operator-supplied options (from=,
#                             restrict, expiry-time=, ...) are
#                             deliberately rejected outright below, not
#                             silently stripped, so alpine-zfsboot
#                             remains the sole owner of what
#                             restrictions actually apply (see the
#                             unconditional option-injection in
#                             rescue-ssh.sh - deliberately NOT the bare
#                             `restrict` keyword itself, since that
#                             also denies pty allocation and would
#                             break interactive rescue sessions).
#                             Deliberately NOT another
#                             alpine-zfsboot.* config key either (an
#                             earlier alpine-zfsboot.ssh_key=<base64
#                             pubkey> cmdline key existed here; removed,
#                             not kept alongside this as a second
#                             mechanism)
#   ssh_host_ed25519_key   - identity: this one machine's persistent
#                             rescue SSH host key (see rescue-ssh.sh's
#                             own header comment for why a fresh host
#                             key every boot was actively undesirable)
# authorized_keys/ssh_host_ed25519_key are staged into fixed tmpfs
# paths here (validated/CR-stripped for the former, copied verbatim for
# the latter - it's dropbear's own binary key format, machine-generated,
# never hand-edited, so no text-file CR hazard applies) for rescue-
# ssh.sh to pick up later, regardless of which of its three trigger
# points ends up calling start_rescue_ssh this boot - same reasoning as
# config's own cmdline-independent staging, just for file-shaped data
# instead of key=value pairs.
#
# Found by FAT volume label, not GPT partition-type GUID: the installer
# already gives the ESP a fixed label (`mkfs.vfat -F32 -n EFI`, see
# alpine-install-zfs.sh) - reusing that existing, working convention
# instead of a new dependency on partition-table introspection busybox's
# blkid may not actually have (it does real filesystem-label detection;
# whether it parses GPT partition-type GUIDs at all is unverified).
# Every matching device is tried in turn, not just the first - if more
# than one disk is labeled EFI, the one actually carrying this
# project's own material wins, not whichever blkid happened to list
# first.
#
# config is pure data even though it's whitelist-parsed the same way
# /proc/cmdline is (apply_zfsboot_kv() only ever matches alpine-
# zfsboot.* keys) - deliberately NOT sourced as a shell script, so its
# content can never run as code regardless of what it contains.
# authorized_keys is validated line-by-line against known SSH key-type
# prefixes (anything else is dropped with a warning, never passed
# through). Real boot only ($ROOTFS-prefixed test runs have no real
# block devices to scan) - unverified against a real ESP/boot, same as
# everything else added today; needs a real-hardware test before this
# is trusted the way the rest of this file is.
#
# Disambiguation is deliberate, not first-match-wins: a candidate must
# carry either this project's own EFI binary (either arch's fallback
# name - checking for either rather than the build's own arch
# specifically, since that's not tracked at runtime here and a
# filesystem carrying either one is equally a real alpine-zfsboot ESP,
# never a coincidental match) OR the BIOS-mode boot payload
# (EFI/ALPINE/KERNEL - see bios/fat.h's own namespace comment; a
# BIOS-only install has no .EFI file at all, but this same partition
# is still the canonical one stage2's own FAT reader loaded the
# running kernel from) AND at least one of the three files above -
# broadened from "config specifically" (an earlier version of this
# check) so a machine that only wants rescue SSH, with no other
# network/bootcheck override, doesn't need an empty config file just
# to be recognized as a real alpine-zfsboot ESP. Exactly one such
# candidate -> use it. Two cloned
# disks both carrying a real ESP is a genuine ambiguity, not a "pick
# one" situation - silently taking whichever blkid happened to list
# first would make selection depend on enumeration order, which can
# change between boots on the same hardware. Loud warning and NONE of
# the three applied instead - defaults/cmdline-only that boot, rescue
# SSH unconfigured, same as if none of this had ever existed, rather
# than a guess nobody asked for.
#
# Which ESP (mirrored boot, issue #24): init/esp-select.sh decides - an
# explicit alpine-zfsboot.esp-uuids= list, the ESP this boot came from
# (alpine-zfsboot.esp-self=, BIOS), the EFI/ALPINE/MEMBER identity
# markers, or - with no marker anywhere, every install before 0.5.0 -
# exactly the single-ESP rule described above. See that file's header.
# When it cannot decide safely it says why and selects nothing: this boot
# then uses defaults/cmdline only, rescue SSH unconfigured, as before.
#
# Real boot only, or a test run that provides fake ESPs (STUB_ESP_DIR,
# tests/run-tests.sh) - every path below is $ROOTFS-prefixed for that.
. "$RESCUE_LIB_DIR/esp-select.sh"
if [ -z "$ROOTFS" ] || [ -n "${STUB_ESP_DIR:-}" ]; then
    mkdir -p "$ROOTFS/tmp/esp-config" "$ROOTFS/tmp/alpine-zfsboot"
    # The two keys esp-select.sh needs before any ESP is read (last
    # occurrence wins, as everywhere on the cmdline).
    ESP_SELECT_CMDLINE_LIST="" ESP_SELECT_SELF=""
    for arg in $(cat "$ROOTFS/proc/cmdline" 2>/dev/null); do
        case "$arg" in
            alpine-zfsboot.esp-uuids=*) ESP_SELECT_CMDLINE_LIST="${arg#alpine-zfsboot.esp-uuids=}" ;;
            alpine-zfsboot.esp-self=*) ESP_SELECT_SELF="${arg#alpine-zfsboot.esp-self=}" ;;
        esac
    done
    if esp_select; then
        esp_candidate="$ESP_SELECTED_DEV"
        msg "alpine-zfsboot ESP found on $esp_candidate (UUID $ESP_SELECTED_UUID: $ESP_SELECTED_REASON)"
        # Exported so read_fat_console_pref() (and any subshell that
        # calls it) sees this value without independently re-running
        # this whole disambiguation scan itself - one discovery pass,
        # one place that decides "this is genuinely the alpine-zfsboot
        # ESP", reused.
        export ALPINE_ZFSBOOT_ESP_DEV="$esp_candidate"
        export ALPINE_ZFSBOOT_ESP_UUID="$ESP_SELECTED_UUID"
        export ALPINE_ZFSBOOT_ESP_INSTALL_ID="$ESP_SELECTED_INSTALL_ID"
        if mount -t vfat -o ro "$esp_candidate" "$ROOTFS/tmp/esp-config" 2>/dev/null; then
            # Seed the console-pref cache (see read_fat_console_pref).
            sed -n 's/^alpine-zfsboot\.console=//p' "$ROOTFS/tmp/esp-config/EFI/ALPINE/config" 2>/dev/null |
                tail -n 1 | tr -d '\r' > "$ROOTFS$_CONSOLE_PREF_CACHE"
            if [ -r "$ROOTFS/tmp/esp-config/EFI/ALPINE/config" ]; then
                msg "applying persisted config (cmdline still overrides)"
                ZFSBOOT_KV_SOURCE=config
                while IFS= read -r line || [ -n "$line" ]; do
                    case "$line" in
                        ''|'#'*) : ;;
                        alpine-zfsboot.*) apply_zfsboot_kv "$line" ;;
                    esac
                done < "$ROOTFS/tmp/esp-config/EFI/ALPINE/config"
                ZFSBOOT_KV_SOURCE=""
            fi

            # Staged as the validated, CR-stripped raw key lines only -
            # no options injected here. That's rescue-ssh.sh's own
            # job (the same mandatory-hardening call it already made for
            # the old single-key mechanism), applied uniformly regardless
            # of what the operator's own file looks like - keeping
            # "find and validate what's on the ESP" here, "how dropbear
            # actually gets invoked" in rescue-ssh.sh, the same split
            # already used for config vs net_config/start_rescue_ssh.
            if [ -r "$ROOTFS/tmp/esp-config/EFI/ALPINE/authorized_keys" ]; then
                zfsboot_keys_found=0
                while IFS= read -r ak_line || [ -n "$ak_line" ]; do
                    # Strip a trailing CR - identical hazard/fix as
                    # config's own CR-stripping in apply_zfsboot_kv():
                    # this file lives on the same FAT partition and is
                    # just as likely to be hand-edited from Windows/
                    # rescue tooling.
                    ak_line="${ak_line%$(printf '\r')}"
                    case "$ak_line" in
                        ''|'#'*) continue ;;
                    esac
                    case "$ak_line" in
                        ssh-ed25519\ *|ssh-rsa\ *|ecdsa-sha2-*\ *|sk-ecdsa-sha2-*\ *|sk-ssh-ed25519\ *)
                            printf '%s\n' "$ak_line" >> "$ROOTFS/tmp/alpine-zfsboot/authorized_keys"
                            zfsboot_keys_found=$((zfsboot_keys_found + 1))
                            ;;
                        *)
                            msg "WARNING: ignoring authorized_keys line that doesn't look like a public key: $ak_line"
                            ;;
                    esac
                done < "$ROOTFS/tmp/esp-config/EFI/ALPINE/authorized_keys"
                msg "authorized_keys: $zfsboot_keys_found usable key(s) found"
            fi

            # Copied verbatim - dropbear's own native key format,
            # machine-generated once by the installer, never hand-
            # edited, so no CR-stripping concern the way config/
            # authorized_keys have. Validity is rescue-ssh.sh's own job
            # (dropbearkey -y), matching where the old ssh_key='s own
            # decode/validity check used to live.
            if [ -r "$ROOTFS/tmp/esp-config/EFI/ALPINE/ssh_host_ed25519_key" ]; then
                cp "$ROOTFS/tmp/esp-config/EFI/ALPINE/ssh_host_ed25519_key" "$ROOTFS/tmp/alpine-zfsboot/ssh_host_ed25519_key"
                chmod 600 "$ROOTFS/tmp/alpine-zfsboot/ssh_host_ed25519_key"
                msg "persistent ssh_host_ed25519_key found"
            else
                msg "no persistent ssh_host_ed25519_key found on the ESP"
            fi

            umount "$ROOTFS/tmp/esp-config" 2>/dev/null
        else
            msg "WARNING: found an alpine-zfsboot ESP candidate ($esp_candidate) but failed to re-mount it - defaults/cmdline only, rescue SSH unconfigured"
        fi
    fi
    # esp_select already said why when it selected nothing (none found,
    # ambiguous, every listed/member ESP unusable).
fi

ZFSBOOT_KV_SOURCE=cmdline
for arg in $(cat "$ROOTFS/proc/cmdline" 2>/dev/null); do
    apply_zfsboot_kv "$arg"
done
ZFSBOOT_KV_SOURCE=""
export ALPINE_ZFSBOOT_POOL="$POOL"
export ALPINE_ZFSBOOT_NET ALPINE_ZFSBOOT_NET_MAC \
    ALPINE_ZFSBOOT_IPV4 ALPINE_ZFSBOOT_IPV4_ADDRESS ALPINE_ZFSBOOT_IPV4_GATEWAY \
    ALPINE_ZFSBOOT_IPV6 ALPINE_ZFSBOOT_IPV6_ADDRESS ALPINE_ZFSBOOT_IPV6_GATEWAY \
    ALPINE_ZFSBOOT_SSH_LISTEN ALPINE_ZFSBOOT_SSH_PORT ALPINE_ZFSBOOT_SSH_ALLOW \
    ALPINE_ZFSBOOT_BOOTCHECK ALPINE_ZFSBOOT_BOOTCHECK_MAX ALPINE_ZFSBOOT_PANIC_TIMEOUT
# Sourced (not exec'd) so its start_rescue_ssh/stop_rescue_ssh
# functions are available to die() below, and to boot-dataset.sh
# separately (it sources this same file itself - one implementation,
# not two). Safe to source unconditionally even when no authorized_keys/
# host key were ever staged above: every function in it no-ops cleanly
# in that case (see its own start_rescue_ssh - the missing-material
# check is its very first guard, reading the same /tmp/alpine-zfsboot/
# staging paths this file just populated, or left empty).
. "$RESCUE_LIB_DIR/rescue-ssh.sh"

# Every build (see build.sh's own CONSOLE_CMDLINE comment) registers
# tty0 only by default now - no serial console= baked in anywhere
# unless an operator put one there themselves, via a real kernel
# cmdline override, a persisted alpine-zfsboot.console= in
# EFI/ALPINE/config (set at install time, when they already have full
# access - not something that needs to be reached by booting first),
# or the pre-boot "press TAB to interrupt" screen for just this one
# boot (e.g. a Kimsufi/OVH-style serial-only rescue boot: TAB, set
# console=ttyS1 for THIS boot, install, write the same value into
# EFI/ALPINE/config while already in there - nothing more needed after
# that). select_console()'s own Layer 2 (FAT config) and Layer 4
# (cmdline) both match against real /dev node existence, not kernel
# console= registration, so a configured serial console works
# correctly regardless of what this file's own CONSOLE_CMDLINE bakes
# in by default.
#
# select_console() picks which real tty menu.py renders to this boot,
# honoring a persisted preference if one exists and this boot actually
# has that candidate - no race, no countdown here: the menu is ALWAYS
# shown immediately now (see the loop further down), with its own
# live-ticking countdown built INTO the real interactive widget itself
# (see menu.py's _countdown_menu()), FreeBSD-loader-style, rather than
# a separate pre-menu prompt that would just be a second, redundant
# screen in front of the real one. Changing console is ONE mechanism,
# deliberately: _boot_args_interrupt() (see its own comment, further
# down), the GRUB-style "press TAB to interrupt" edit screen that runs
# BEFORE any of this, on every boot. It writes ZFSBOOT_CONSOLE_CMDLINE
# directly (Layer 3 below), the same variable a real kernel cmdline
# alpine-zfsboot.console= populates - a genuine, full passthrough to
# apply_zfsboot_kv(), with no precedence rule of its own to keep in
# sync with this file's other layers. An earlier version of this
# project also had a separate LIVE claim mechanism (a tty0 keypress or
# a serial "menu"+Enter, rerouting an already-running menu to a
# different console) - removed by deliberate choice, same reasoning as
# the NVRAM removal below: a second way to change console bought
# confusion (which one actually applies right now?), not real
# capability the pre-boot screen doesn't already cover - reboot and
# press TAB.
#
# Three layers, lowest to highest priority - one PERSISTED mechanism:
# an earlier version of this project also had a UEFI NVRAM variable
# (AlpineZfsBootConsole) as a second, operator-writable persistence
# layer alongside the FAT config below, kept deliberately separate from
# it (a fleet-wide installer default vs. one operator's own override on
# a single box). Removed by deliberate choice: one config format, one
# place to look, no firmware-dependent second mechanism that only even
# existed on UEFI hosts to begin with - BIOS never had an equivalent. A
# one-boot-only console change (an operator who wants THIS boot,
# specifically, on a different console, nothing persisted) goes through
# the pre-boot edit screen above instead - not a second persistence
# store.
#
#   1. kernel's own active console (baseline - see below)
#   2. FAT config (alpine-zfsboot.console= in EFI/ALPINE/config, see
#      apply_zfsboot_kv()) - the ONE persisted preference, machine-wide,
#      works on every layout (UEFI or BIOS), set at install time or by
#      hand-editing the ESP.
#   3. explicit kernel cmdline alpine-zfsboot.console= (or the pre-boot
#      edit screen, which is a passthrough onto this exact same layer) -
#      always wins, unconditionally, every call - the same "cmdline
#      overrides persisted config" convention every other
#      alpine-zfsboot.* key already follows, just carried all the way
#      through here instead of only applying once at boot.
#
# Layer 2 needs a FRESH read on every single call, not a cached value
# from a one-time boot-time parse: a relaunch (43, see recovery_shell()'s
# own comment) re-enters this function in a NEW process, and a hand-edit
# of the ESP config over a long-running rescue SSH session must be
# picked up just as freshly. Layer 3 (cmdline), by contrast, is a single
# boot-time value by its own nature - captured once into
# ZFSBOOT_CONSOLE_CMDLINE by apply_zfsboot_kv() (see its own
# ZFSBOOT_KV_SOURCE handling, and _boot_args_interrupt()'s own comment
# for the pre-boot edit screen that can also populate it, once, before
# the main loop below ever starts) and never needs re-reading after
# that.
# The config layer must never silently vanish: if the read-only mount fails
# (e.g. the operator already has the ESP mounted read-write in the recovery
# shell to fix it - the very fix path die() points at), read it from where
# it is already mounted, and failing that fall back to the value last read
# successfully (seeded at boot) WITH a warning - never "no config".
_read_console_pref_from() {
    sed -n 's/^alpine-zfsboot\.console=//p' "$1/EFI/ALPINE/config" 2>/dev/null |
        tail -n 1 | tr -d '\r'
}
read_fat_console_pref() {
    [ -n "$ALPINE_ZFSBOOT_ESP_DEV" ] || return
    if mount -t vfat -o ro "$ALPINE_ZFSBOOT_ESP_DEV" /tmp/esp-config 2>/dev/null; then
        _pref="$(_read_console_pref_from /tmp/esp-config)"
        umount /tmp/esp-config 2>/dev/null
        printf '%s\n' "$_pref" > "$_CONSOLE_PREF_CACHE" 2>/dev/null
        printf '%s\n' "$_pref"
        return
    fi
    _mp="$(awk -v d="$ALPINE_ZFSBOOT_ESP_DEV" '$1==d {print $2; exit}' /proc/mounts 2>/dev/null)"
    if [ -n "$_mp" ] && [ -r "$_mp/EFI/ALPINE/config" ]; then
        _pref="$(_read_console_pref_from "$_mp")"
        printf '%s\n' "$_pref" > "$_CONSOLE_PREF_CACHE" 2>/dev/null
        printf '%s\n' "$_pref"
        return
    fi
    msg "WARNING: cannot re-read EFI/ALPINE/config from $ALPINE_ZFSBOOT_ESP_DEV - keeping the console value read earlier" >&2
    cat "$_CONSOLE_PREF_CACHE" 2>/dev/null
}

# _parse_console_spec SPEC - splits SPEC into _CONSOLE_SPEC_TTY (bare
# tty name, e.g. "ttyS1" - what every candidate-matching comparison in
# select_console() below already needs) and _CONSOLE_SPEC_OPTS
# (everything after the first comma, or empty) - two globals rather
# than a return value, same idiom ACTIVE_TTY/ACTIVE_CONSOLE_OPTS already
# use throughout this file. Real gap this closes: a value like
# "ttyS1,115200n1" (the kernel's OWN console=ttySn,<baud><parity><bits>
# convention, which an operator naturally reaches for since
# CONSOLE_CMDLINE already bakes in exactly this shape - see build.sh)
# used to be compared WHOLE against bare candidate names like "ttyS1"
# in every layer below - which can never match, so the override
# silently never applied at all. Only a bare tty name with no options
# ever actually worked before this.
_parse_console_spec() {
    case "$1" in
        *,*) _CONSOLE_SPEC_TTY="${1%%,*}"; _CONSOLE_SPEC_OPTS="${1#*,}" ;;
        *)   _CONSOLE_SPEC_TTY="$1"; _CONSOLE_SPEC_OPTS="" ;;
    esac
}

# _apply_console_line_settings OPTS - parses a kernel console=-style
# "<baud><parity n/e/o><bits 5-8>" suffix (e.g. "115200n8" - the exact
# same convention CONSOLE_CMDLINE already bakes in for its own serial
# console, see build.sh) into real stty flags. Applies to whatever tty
# is already on this process's own stdin (see the exec redirect right
# before this is called in the main loop) - same "already redirected,
# operate on stdin implicitly" idiom the existing `stty rows 24 cols 80`
# geometry call already uses.
#
# Falls back to 115200n8 (the already-shipped, real-hardware-verified
# default for a bare tty name with no explicit options) on: no options
# given at all, a non-numeric/missing baud, or anything not matching
# the accepted shape - never raises, same never-crash defensiveness
# _parse_menu_timeout()/_parse_menu_grace() (see init/menu.py) already
# follow for the same reason: a malformed operator-supplied value must
# degrade to a safe default, not take the whole boot down.
#
# PR #16 review (F2): the kernel's own console= grammar this is meant
# to mirror is actually "<baud><parity><bits><flow>", with parity/bits
# BOTH optional (defaulting to n8) and an optional trailing "r" for
# RTS/CTS flow control - not the "all three or nothing" shape this
# function originally required. That meant the single most natural
# thing an operator would type for e.g. a 9600-baud BMC,
# alpine-zfsboot.console=ttyS1,9600, silently got REPLACED with
# 115200 - exactly the silent-console symptom this whole feature exists
# to fix, now self-inflicted on a console the operator explicitly
# configured. Fixed: baud is still parsed the same way (longest leading
# digit run); an optional trailing "r" is stripped first for the flow
# flag; whatever's left is at most one parity character (defaulting to
# n) and a bits digit (defaulting to 8) - matching the kernel's own
# optionality, not just its character set.
#
# PR #16 review (F3): this also used to run unconditionally on the
# kernel's OWN already-registered console (e.g. plain
# alpine-zfsboot.console=ttyS0 with no options, when ttyS0 is already
# what CONSOLE_CMDLINE told the kernel to use) - forcing 115200n8 onto
# a line the kernel's own console= parsing already configured
# correctly, which only matters when that rate isn't 115200 to begin
# with (e.g. a EXTRA_CMDLINE override, or firmware LoadOptions per fix
# #1 above), but is still needless churn when it's a no-op. A bare name
# (no explicit options) that already names a live kernel console now
# returns without touching the line at all.
_apply_console_line_settings() {
    opts="$1"
    if [ -n "$opts" ]; then
        baud="${opts%%[!0-9]*}"
        rest="${opts#"$baud"}"
        flow=""
        case "$rest" in *r) flow=crtscts; rest="${rest%r}" ;; esac
        parity_char="${rest%"${rest#?}"}"
        bits="${rest#?}"
        [ -n "$parity_char" ] || parity_char=n
        [ -n "$bits" ] || bits=8
        if [ -n "$baud" ]; then
            case "$parity_char$bits" in
                n[5678]) stty "$baud" "cs$bits" -parenb -cstopb $flow 2>/dev/null; return ;;
                e[5678]) stty "$baud" "cs$bits" parenb -parodd -cstopb $flow 2>/dev/null; return ;;
                o[5678]) stty "$baud" "cs$bits" parenb parodd -cstopb $flow 2>/dev/null; return ;;
            esac
        fi
        msg "WARNING: alpine-zfsboot.console= line options '$opts' not in <baud><parity><bits> form (parity/bits optional - e.g. 9600, 115200n8, 9600n8r) - using 115200n8 instead"
    elif [ -n "$ACTIVE_TTY" ] && grep -qw "$ACTIVE_TTY" "$ROOTFS/sys/class/tty/console/active" 2>/dev/null; then
        return   # the kernel's own console= already set this line's rate
    fi
    stty 115200 cs8 -parenb -cstopb 2>/dev/null
}

ACTIVE_TTY=tty0
ACTIVE_CONSOLE_OPTS=""
LAST_NOTIFIED_TTY=""

# notify_inactive_consoles - real gap found via a design
# review, after a real Netcup VM incident: /init (and everything
# menu.py later prints) only ever writes to ACTIVE_TTY - EVERY other
# console CONSOLE_CMDLINE registered (see build.sh) goes completely
# silent the moment userspace takes over, with zero indication anything
# is happening or how to reach the real menu. On that Netcup box
# (UEFI, VNC console showing only tty0), the operator watched normal
# kernel boot messages stop dead and saw nothing else ever again -
# indistinguishable from a hang, even though the interactive menu was
# alive the whole time on ttyS0 (the kernel's own default per
# select_console()'s "last console= wins" rule). Fixed: a one-time
# (per ACTIVE_TTY change, tracked via LAST_NOTIFIED_TTY so a 43
# relaunch onto the SAME console doesn't spam it again) banner written
# directly to every OTHER currently-registered kernel console,
# explaining where the real menu is and how to move it here.
#
# Deliberately targets /sys/class/tty/console/active (the kernel's own
# registered-console list), not select_console()'s full candidate set:
# those are exactly the consoles that already received real kernel
# dmesg output and then went dark (the incident shape), and - just as
# importantly - the ONLY ones whose line settings the kernel's own
# console= parsing already configured correctly. A candidate the
# kernel never registered as a console sits at a hardcoded 9600n8 (see
# _apply_console_line_settings's own comment) - writing a banner there
# would frame incorrectly or not appear at all on a real fixed-rate
# remote listener, the exact silent-console problem this project
# already spent real effort fixing elsewhere. Every write wrapped in a
# subshell with its own redirect, same idiom and the same reason as the
# stty -g open-test right below this function's own caller: a
# PORT_UNKNOWN node opens fine but EIOs on write, and PID 1 must
# survive that regardless.
#
# No live "press a key to claim this console" hint anymore - an earlier
# version of this project had one (a tty0 keypress, or typing "menu" on
# a serial line, would reroute the already-running menu here) and it
# was removed by deliberate choice: a second way to change console,
# alongside _boot_args_interrupt()'s own pre-boot screen, bought
# confusion (which one actually applies right now, given a persisted
# FAT-config preference?) rather than real capability - "reboot and
# press TAB" covers the same need with one answer, not two. This
# banner's own job stays the same regardless: tell an operator on an
# otherwise-silent console where the menu actually is and how to get it
# there NEXT boot, so the console's own silence is never again
# mistaken for a hang (the original Netcup incident).
notify_inactive_consoles() {
    [ "$LAST_NOTIFIED_TTY" = "$ACTIVE_TTY" ] && return
    LAST_NOTIFIED_TTY="$ACTIVE_TTY"
    # Registered consoles PLUS _extra_relevant_consoles() (see its own
    # comment, further down) - a later review found this loop used
    # to only ever consider kernel-registered consoles, so an operator
    # whose FAT-persisted console preference got outvoted by a one-boot
    # cmdline override (Layer 3 always wins) saw a real, working
    # pre-boot TAB countdown on their own console, then permanent
    # silence afterward - never told the menu moved elsewhere, because
    # this loop never even considered that device. `_seen` dedups
    # against whatever the registered loop already queued, so a device
    # that's both registered AND _extra_relevant_consoles()'s own answer
    # (the common case: they usually agree) never gets banner-ed twice.
    _seen=""
    for tty in $(cat "$ROOTFS/sys/class/tty/console/active" 2>/dev/null) $(_extra_relevant_consoles); do
        case " $_seen " in *" $tty "*) continue ;; esac
        _seen="$_seen $tty"
        [ "$tty" = "$ACTIVE_TTY" ] && continue
        [ -e "$ROOTFS/dev/$tty" ] || continue
        ( {
            echo "alpine-zfsboot: the interactive boot menu is running on /dev/$ACTIVE_TTY, NOT here."
            echo "alpine-zfsboot: this console stays quiet on purpose - the system is not hung."
            if _is_known_console_name "$tty"; then
                echo "alpine-zfsboot: to make THIS console (/dev/$tty) the menu console, reboot, press TAB at"
                echo "alpine-zfsboot: the 'alpine-zfsboot starting' prompt and set"
                echo "alpine-zfsboot:   alpine-zfsboot.console=$tty"
                echo "alpine-zfsboot: on the edit line, or set it in EFI/ALPINE/config on the ESP to persist it."
            else
                # A gap: this console IS
                # kernel-registered (it's in console/active, which is
                # all this loop checks), but its NAME isn't one
                # select_console() itself will ever recognize (see
                # _known_console_names's own comment) - the advice
                # above would be a guaranteed, silently-rejected dead
                # end here (select_console()'s own Layer 2/3 warning
                # would fire every single boot, forever, for an
                # operator who followed this exact instruction).
                echo "alpine-zfsboot: /dev/$tty isn't a console name this build can select at all"
                echo "alpine-zfsboot: (not in: tty0, ttyS0, ttyS1, ttyS2, ttyAMA0) - TAB/console="
                echo "alpine-zfsboot: here would be accepted but never actually take effect."
            fi
        } > "$ROOTFS/dev/$tty" ) 2>/dev/null
    done
}

# _notify_recovery_shell_elsewhere - die()'s own analogue of
# notify_inactive_consoles(), for the same reason: a multi-registered-
# console build (an explicit cmdline naming more than one console=)
# used to have die()'s own FATAL message and recovery shell reach only
# whichever console this process's stdio happened to be attached to at
# that moment - every OTHER registered console saw nothing at all.
#
# Deliberately NOT the same fix shape as notify_inactive_consoles()
# though: this does NOT repeat the SAME "dropping to a recovery shell"
# text on every console.
# PID 1 only ever has ONE stdin, so only ONE console can possibly have
# a REAL, working shell attached; writing the identical "here's your
# shell" promise to every console would make the others LOOK just as
# functional as the real one when they categorically cannot be - the
# exact same "last one wins, so saying this on all of them is a lie"
# shape the operator flagged. Every OTHER console gets a plainly
# DIFFERENT, honest message instead: the real thing is happening
# elsewhere, not here.
#
# Finds which device this process's OWN fd 0 is actually attached to
# RIGHT NOW via /proc/self/fd/0 - real, ground-truth kernel state, not
# a bookkeeping variable this file would otherwise have to keep
# perfectly in sync across every die() call site, including ones that
# fire before any console was ever successfully exec'd onto this boot
# at all (this file's own main loop may call die() before its own
# `exec` ever runs - see that guard's own comment - so there is no
# "last successfully attached console" variable to fall back on there).
# Deliberately NOT $ROOTFS-prefixed: /proc/self is this ACTUAL running
# process's own real kernel-provided view, never something a test
# fixture's fake root could stand in for (unlike /dev or /sys, which
# tests/run-tests.sh fakes under $ROOTFS on purpose) - under a real
# boot $ROOTFS is empty anyway, so this is identical there either way.
# `readlink -f` on both sides of the comparison below (not a bare name
# compare) so this also works correctly when `$ROOTFS/dev/$tty` is a
# symlink to a real pty (tests/run-tests.sh's own fixture shape)
# rather than a real device node (the real-boot shape) - either way,
# both resolve to the same real underlying path when they're actually
# the same device.
_notify_recovery_shell_elsewhere() {
    _my_tty="$(readlink -f /proc/self/fd/0 2>/dev/null)"
    # Before the main loop's exec, PID 1's stdio is the fd the kernel
    # opened from /dev/console, which resolves to the literal path
    # /dev/console and never equals any /dev/<tty> name below. That is the
    # kernel's preferred console: the LAST entry of console/active.
    if [ "$_my_tty" = /dev/console ]; then
        _c=""
        for _c in $(cat "$ROOTFS/sys/class/tty/console/active" 2>/dev/null); do :; done
        [ -n "$_c" ] && _my_tty="$(readlink -f "$ROOTFS/dev/$_c" 2>/dev/null)"
    fi
    _seen=""
    for tty in $(cat "$ROOTFS/sys/class/tty/console/active" 2>/dev/null) $(_extra_relevant_consoles); do
        case " $_seen " in *" $tty "*) continue ;; esac
        _seen="$_seen $tty"
        [ -e "$ROOTFS/dev/$tty" ] || continue
        [ -n "$_my_tty" ] && [ "$(readlink -f "$ROOTFS/dev/$tty" 2>/dev/null)" = "$_my_tty" ] && continue
        ( {
            echo "alpine-zfsboot: a FATAL error occurred - dropping to a recovery shell on a"
            echo "alpine-zfsboot: DIFFERENT console, NOT here. This console stays quiet on"
            echo "alpine-zfsboot: purpose - check whichever console showed earlier boot messages."
        } > "$ROOTFS/dev/$tty" ) 2>/dev/null
    done
}

# _known_console_names/_is_known_console_name - the ONE list of device
# NAMES this project treats as a console candidate at all (ttyS1/ttyS2
# alongside ttyS0/ttyAMA0 - confirmed a real need on physical OVH
# hardware, whose remote-console redirection doesn't always land on
# ttyS0). Factored out, rather than left as a literal inline the way
# select_console() used to have it, so _boot_args_interrupt()'s own
# pre-boot validation (see its own comment) can check the EXACT same
# definition of "a console name this build supports" - a real,
# gap otherwise: that validation's own `stty -g`
# open-test accepts ANY openable device, a strictly MORE permissive
# definition than this list, so a genuinely live ttyS3/ttyAMA1/hvc0
# could be force-accepted there and then silently dropped by
# select_console() anyway, with a warning that wrongly claims the
# device doesn't exist when it's simply not a name this build
# recognizes as a console at all.
_known_console_names() {
    echo "tty0 ttyS0 ttyS1 ttyS2 ttyAMA0"
}
_is_known_console_name() {
    for _known in $(_known_console_names); do
        [ "$_known" = "$1" ] && return 0
    done
    return 1
}

# _extra_relevant_consoles - the ONE shared answer to "which non-
# kernel-registered consoles matter this boot" - used by BOTH
# _boot_args_interrupt() (so the pre-boot TAB prompt is visible there
# too) and notify_inactive_consoles() (so a "menu is elsewhere" banner
# reaches there too, not just silence).
#
# Real, reported bug (2026-10-02, a real Proxmox VM, serial-only access
# via `qm terminal`, a totally fresh ISO boot with NO persisted config
# yet): an earlier version of this function only ever considered a
# device the operator had ALREADY told this project about (a FAT-config
# preference, or the already-resolved $ACTIVE_TTY) - on a pristine
# machine with neither (this build's own CONSOLE_CMDLINE is tty0-only,
# see build.sh's own comment on why), a genuinely live, open serial port
# (ttyS0 - the 8250 driver registers it as a real /dev node independent
# of whether console= ever named it, confirmed present on virtually any
# x86 VM/bare metal with a UART) never got a SINGLE CHANCE at the
# pre-boot prompt. An operator whose only real access IS serial (this
# exact test, and the Kimsufi Serial-over-LAN scenario the operator
# raised earlier the same day) was completely locked out on the very
# first boot, with no way to even reach the mechanism meant to fix
# this - config can only ever be persisted AFTER a successful first
# interaction, so requiring prior config here was circular.
#
# Fixed: tries EVERY _known_console_names() entry, not just ones
# already named by FAT config or $ACTIVE_TTY - gated the same way an
# operator-named console already is elsewhere in this file (genuinely
# openable, `stty -g`, never just "the node exists" - a PORT_UNKNOWN
# node passes that and nothing else, so this can never busy-loop
# _boot_args_wait_for_tab()'s own reader on a node proven dead).
# Skips anything the registered-console loop (in both callers) already
# has - this function's whole job is the NON-registered remainder.
# Applies real line settings to each qualifying device before
# returning it (a non-registered line sits at the kernel's hardcoded
# 9600n8 otherwise, which would make both the TAB countdown and
# notify_inactive_consoles()'s own banner arrive as garbage at
# whatever real baud rate is actually listening) - the FAT preference's
# own explicit opts, or $ACTIVE_TTY's own resolved opts, win for
# whichever device they each specifically name; everything else found
# only by this new blind sweep defaults to 115200n8, this project's own
# standard rate, since nothing has told us otherwise for it.
_extra_relevant_consoles() {
    _extra=""
    _registered="$(cat "$ROOTFS/sys/class/tty/console/active" 2>/dev/null)"
    fat_pref="$(read_fat_console_pref)"
    _parse_console_spec "$fat_pref"
    _fat_tty="$_CONSOLE_SPEC_TTY"
    _fat_opts="$_CONSOLE_SPEC_OPTS"
    for tty in $(_known_console_names); do
        case " $_registered " in *" $tty "*) continue ;; esac
        case " $_extra " in *" $tty "*) continue ;; esac
        [ -e "$ROOTFS/dev/$tty" ] || continue
        ( stty -g < "$ROOTFS/dev/$tty" ) >/dev/null 2>&1 || continue
        if [ "$tty" = "$_fat_tty" ]; then
            _opts="${_fat_opts:-115200n8}"
        elif [ "$tty" = "$ACTIVE_TTY" ]; then
            _opts="${ACTIVE_CONSOLE_OPTS:-115200n8}"
        else
            _opts="115200n8"
        fi
        _apply_console_line_settings "$_opts" \
            < "$ROOTFS/dev/$tty" > "$ROOTFS/dev/$tty" 2>/dev/null
        _extra="$_extra $tty"
    done
    echo "$_extra"
}

select_console() {
    # Set when an operator-chosen console (config or cmdline) cannot be
    # used at all - missing node or a name outside _known_console_names.
    # The main loop treats it exactly like a present-but-dead node: die().
    CONSOLE_UNUSABLE=""
    candidates=""
    for tty in $(_known_console_names); do
        [ -e "$ROOTFS/dev/$tty" ] && candidates="$candidates $tty"
    done
    set -- $candidates
    if [ "$#" -eq 0 ]; then
        return
    fi

    # Default to whichever console the KERNEL ITSELF already treats as
    # primary - not a fixed, arbitrary "first candidate found" guess.
    # /sys/class/tty/console/active lists every registered console in
    # cmdline order (a standard kernel-exposed file); the LAST one is
    # the one the kernel actually uses as /dev/console, per its own
    # "last console= wins" convention - the exact same convention this
    # project's own `auto` cmdline already relies on. Confirmed the
    # hard way on real hardware: an earlier version always defaulted
    # to tty0 first-found regardless of which console pid 1 itself was
    # ALREADY writing to before this function ever ran - /init's own
    # earlier msg() calls (e.g. "importing pool: zroot") had already
    # been appearing on THAT console the whole boot, and blindly
    # switching to a different one here, on a first boot with no
    # persisted preference yet, made the console someone was actually
    # watching go silent with no warning while the menu kept running
    # invisibly on the other one.
    ACTIVE_TTY="$1"
    for tty in $(cat "$ROOTFS/sys/class/tty/console/active" 2>/dev/null); do
        for candidate in $candidates; do
            [ "$tty" = "$candidate" ] && ACTIVE_TTY="$candidate"
        done
    done

    # No explicit line options for this one - the kernel already
    # configured its own registered console correctly via its own
    # console= parsing. Layers 2-3 below set ACTIVE_CONSOLE_OPTS
    # explicitly if an operator's own choice needs them.
    ACTIVE_CONSOLE_OPTS=""

    # Layer 2: FAT config (canonical machine default) - fresh read
    # every call, see this function's own header comment for why.
    # _parse_console_spec (see its own comment) splits an optional
    # kernel console=-style ",<baud><parity><bits>" suffix off the bare
    # tty name before comparing against candidates - a spec WITH options
    # never matched a bare candidate name before this existed.
    pref="$(read_fat_console_pref)"
    _parse_console_spec "$pref"
    _matched=0
    for tty in $candidates; do
        if [ "$tty" = "$_CONSOLE_SPEC_TTY" ]; then
            ACTIVE_TTY="$tty"
            ACTIVE_CONSOLE_OPTS="$_CONSOLE_SPEC_OPTS"
            _matched=1
        fi
    done
    # A real, reported gap: an operator-specified console (FAT config
    # or cmdline, below - both a DELIBERATE choice, unlike Layer 1's
    # automatic kernel default) that doesn't match any real candidate
    # used to be silently ignored - no warning, no indication anything
    # was even tried, the menu just quietly stayed on whatever the
    # previous layer picked. A real incident: an operator edited
    # alpine-zfsboot.console= to a tty with no actual /dev node in this
    # guest (e.g. no serial0 device attached in Proxmox) via the
    # pre-boot TAB-interrupt screen, confirmed it, and the menu came up
    # on tty0 anyway with nothing on screen explaining why their choice
    # didn't apply. "no /dev/$X node" is deliberately NOT claimed here -
    # a non-match against $candidates can equally mean the name IS a
    # real, existing, openable device that just isn't one of
    # _known_console_names's own small supported set (ttyS3, ttyAMA1,
    # hvc0, ...) - saying "no such device" would be factually wrong in
    # that case (a real, issue with the original
    # wording).
    if [ -n "$_CONSOLE_SPEC_TTY" ] && [ "$_matched" -eq 0 ]; then
        msg "WARNING: alpine-zfsboot.console=$pref (from EFI/ALPINE/config) names a console this build doesn't support as /dev/$_CONSOLE_SPEC_TTY (unsupported name, or no such node this boot)"
        CONSOLE_UNUSABLE="alpine-zfsboot.console=$pref (from EFI/ALPINE/config) names /dev/$_CONSOLE_SPEC_TTY, which is not a supported console name or has no device node this boot"
    fi

    # Layer 3: explicit kernel cmdline - always wins, unconditionally,
    # every call (ZFSBOOT_CONSOLE_CMDLINE is a single boot-time value
    # by its own nature - see apply_zfsboot_kv()'s own comment).
    _parse_console_spec "$ZFSBOOT_CONSOLE_CMDLINE"
    _matched=0
    for tty in $candidates; do
        if [ "$tty" = "$_CONSOLE_SPEC_TTY" ]; then
            ACTIVE_TTY="$tty"
            ACTIVE_CONSOLE_OPTS="$_CONSOLE_SPEC_OPTS"
            _matched=1
        fi
    done
    if [ -n "$_CONSOLE_SPEC_TTY" ] && [ "$_matched" -eq 0 ]; then
        msg "WARNING: alpine-zfsboot.console=$ZFSBOOT_CONSOLE_CMDLINE (from the kernel cmdline, or the pre-boot TAB-interrupt edit screen) names a console this build doesn't support as /dev/$_CONSOLE_SPEC_TTY (unsupported name, or no such node this boot)"
        CONSOLE_UNUSABLE="alpine-zfsboot.console=$ZFSBOOT_CONSOLE_CMDLINE (from the cmdline / pre-boot screen) names /dev/$_CONSOLE_SPEC_TTY, which is not a supported console name or has no device node this boot"
    elif [ -n "$_CONSOLE_SPEC_TTY" ]; then
        # A valid cmdline override outvotes a bad persisted config value
        # for this boot - the operator has already chosen a working console.
        CONSOLE_UNUSABLE=""
    fi
}

# _boot_args_interrupt - the actual GRUB-style "press TAB to interrupt"
# gate: the EARLIEST point of interactivity in this
# whole script, before attempt_pool_import (see its own call site
# below), on EVERY boot - an installed disk's own boot-environment boot
# and a rescue ISO boot both run this exact same /init, so there is no
# separate "ISO path" vs. "HDD path" to keep in sync here, by
# construction.
#
# Deliberately NOT a second persistence/override mechanism: a confirmed
# edit here is re-parsed through apply_zfsboot_kv() - the SAME function
# that already parses both the FAT config file and the real kernel
# cmdline (see that function's own header comment) - with
# ZFSBOOT_KV_SOURCE=cmdline, so alpine-zfsboot.console= lands in
# ZFSBOOT_CONSOLE_CMDLINE, select_console()'s own Layer 3 above. A
# console (or anything else alpine-zfsboot.*) typed here behaves
# EXACTLY as if it had been typed on the real kernel cmdline at boot -
# a genuine, unconditional, full passthrough, not a new precedence rule
# anywhere. This is the ONE mechanism for changing console on this
# project now - an earlier version also had a live claim (a tty0
# keypress/serial "menu"+Enter rerouting an already-running menu),
# removed by deliberate choice (see select_console()'s own header
# comment).
#
# select_console() must already have run once before this is called
# (see its own call site below) so ACTIVE_TTY/ACTIVE_CONSOLE_OPTS
# reflect Layers 1-2 (kernel default, FAT config) - exactly the
# "default stuff that comes from the EFI config if set, else just
# default" the edit screen is supposed to show.
#
# Split into three single-purpose pieces, same idiom as
# _parse_console_spec/_apply_console_line_settings above: each one
# takes its real inputs as explicit arguments or $ROOTFS-prefixed
# paths, not bare globals/absolute paths, specifically so
# tests/run-tests.sh can exercise it for real (a real pty for the
# keypress-timeout piece, a fake $ROOTFS/proc/cmdline for the default-
# line piece) instead of this whole feature being only a static source
# check, the class of limitation most of this file's OTHER tty-shaped
# code is stuck with.

# _boot_args_wait_for_tab TTY_DEV TIMEOUT - polls TTY_DEV for a bare TAB
# keypress for up to TIMEOUT seconds, redrawing a countdown on the same
# device each second it waits. Returns 0 (countdown line cleared) the
# instant TAB is seen, 1 once the timeout elapses untouched (also
# cleared - never leaves a stale countdown line behind on the ordinary,
# unattended path).
# _tty_safe_name TTY_DEV - a filesystem-safe sentinel-file name for
# TTY_DEV (just "/" -> "_" - these are always "/dev/something" or
# "$ROOTFS/dev/something" paths, never anything stranger). Plain
# parameter-expansion character walk, not `tr` - one fewer external
# binary this early in boot, and this runs on at most a handful of
# short paths, never a hot loop.
_tty_safe_name() {
    s="$1"
    r=""
    while [ -n "$s" ]; do
        c="${s%"${s#?}"}"
        s="${s#?}"
        case "$c" in
            /) r="${r}_" ;;
            *) r="${r}${c}" ;;
        esac
    done
    echo "$r"
}

# _boot_args_wait_for_tab TTY_DEVS TIMEOUT - TTY_DEVS is a SPACE-
# SEPARATED list of /dev/* paths (not a single device - see this
# function's own caller for why more than one is the ordinary case
# here, not an edge case). Polls EVERY one of them for a bare TAB
# keypress, redrawing the same countdown on all of them every second,
# and returns the instant any one of them sees it.
#
# Real CONCURRENT listening, not sequential - a background `read -t
# TIMEOUT -n 1` per device (not `-t 1`, repeated and summed), each
# touching its own sentinel file in a private mktemp dir on a TAB
# match, while this function's own loop just redraws the countdown and
# polls for a sentinel file once a second. TIMEOUT is therefore the
# REAL, exact wall-clock delay added to every boot, regardless of how
# many consoles are registered - a real, reported problem with an
# earlier, sequential-per-tick version of this function: TIMEOUT *
# (number of devices) silently turned a requested 15s window into 30s+
# whenever more than one console was being polled (every build was
# dual-console by default at the time this was found - see build.sh's
# own CONSOLE_CMDLINE comment for why that's no longer true - but any
# operator with a persisted FAT-config serial preference still polls
# two consoles today, same risk), on every single boot, unattended or
# not.
# Background jobs are killed (and reaped via `wait`) the moment a
# winner is found OR the timeout genuinely elapses, so this never
# leaves a stray `read` holding a console open past its own return.
_boot_args_wait_for_tab() {
    ttys="$1"
    timeout="$2"
    # Optional: ports the operator is known to watch (kernel-registered,
    # configured, or active). On any OTHER port - found only by the blind
    # sweep - a CR/LF counts as ENTER only if no other byte arrived first,
    # so a UPS or noisy device streaming status lines (text ending in CR/LF)
    # cannot cut the countdown short.
    trusted="${3:-$1}"
    tmpdir="$(mktemp -d)"
    # Fail CLOSED, not open: an unguarded mktemp failure here (ENOSPC,
    # a read-only /tmp, resource exhaustion - exactly the kind of thing
    # more likely to be the REASON this is even running, not a rare
    # unrelated coincidence) used to leave $tmpdir empty, so every
    # "$tmpdir/$safe" sentinel path below silently became a bare
    # "/$safe" at the filesystem ROOT - PID 1 runs as root, so that
    # write could actually succeed there instead of failing loudly,
    # and a PRE-EXISTING file at that exact root-level path would have
    # made this function report a false "winner" with no real keypress
    # ever happening. Skip the whole interactive gate for this boot
    # instead - the same fail-safe posture this project already uses
    # elsewhere (e.g. zfs-unlock.sh's own fail-closed passphrase
    # prompt) - an unattended boot proceeding untouched is always the
    # safe outcome; a phantom TAB firing because of a tmpdir mix-up is
    # not.
    if [ -z "$tmpdir" ] || [ ! -d "$tmpdir" ]; then
        msg "WARNING: mktemp -d failed - skipping the press-TAB-to-interrupt prompt this boot"
        return 1
    fi
    pids=""
    for tty_dev in $ttys; do
        safe="$(_tty_safe_name "$tty_dev")"
        # A single one-shot `read -n 1` here was a real, reported bug:
        # it consumes exactly ONE byte and then the backgrounded reader
        # exits for good - an operator who pressed anything else first
        # (ESC, a stray key while the VM console window was regaining
        # focus) silently killed this console's own listener for the
        # rest of the whole countdown, so a TAB pressed a moment later
        # landed on nobody. Looping reads until either TAB arrives or
        # the real deadline (wall-clock, via `date +%s` - not a
        # decrementing counter, so a read that returns early because
        # a non-TAB byte arrived doesn't silently grant extra total
        # time) passes keeps listening for TAB specifically, the whole
        # window, regardless of what else was typed first.
        (
            # `remaining` seeded to the plain, exact `$timeout` for the
            # FIRST read, not computed from `date +%s` beforehand - a
            # boundary bug otherwise: `date
            # +%s` has 1-second resolution, and the gap between
            # computing `deadline` and this first check is real
            # wall-clock time (a few ms, two separate fork+execs) - if
            # the real second ticks over in that gap, the first
            # `remaining` computes as `timeout - 1`, which is exactly
            # `0` for `alpine-zfsboot.interrupt_timeout=1` (a legal
            # value per this function's own 0-60 validation above) -
            # `break` before ever calling `read` even once, silently
            # skipping this console's entire listening window while
            # the countdown banner still claims to be waiting. Every
            # LATER iteration still measures `remaining` against the
            # real deadline after its own read returns, same as
            # before - only the very first read is exempted from that
            # measurement, since nothing has had a chance to tick yet.
            deadline=$(($(date +%s) + timeout))
            remaining="$timeout"
            noisy=0
            while :; do
                # key cleared first: under `set -u`, a first read that times
                # out leaves it unset, and the test below would abort this
                # reader with a shell error on the console of every clean boot.
                key=""
                # Once a port has sent something other than TAB/ENTER, read
                # with a 1s timeout: a device writes a whole line in one
                # burst, a person pauses. A quiet second ends the "noise"
                # state, so a person's ENTER after a stray key (arrow, Esc)
                # still counts, while a device's status line does not.
                _t="$remaining"; [ "$noisy" -eq 1 ] && [ "$_t" -gt 1 ] && _t=1
                IFS= read -t "$_t" -n 1 -r key < "$tty_dev" 2>/dev/null
                _read_rc=$?
                [ "$_read_rc" -ne 0 ] && [ "$noisy" -eq 1 ] && noisy=0
                [ -n "$key" ] && [ "$key" != "$(printf '\t')" ] && noisy=1
                # TAB wins only from a person: on a port nobody is known to
                # watch (found only by the blind sweep), a TAB inside a
                # device's burst (a UPS "OL<TAB>230V" line) must not open an
                # edit screen nobody can see and stall the boot.
                if [ "$key" = "$(printf '\t')" ] \
                    && { [ "$noisy" -eq 0 ] || case " $trusted " in *" $tty_dev "*) true ;; *) false ;; esac; }; then
                    : > "$tmpdir/$safe"
                    break
                fi
                # being forced to sit out
                # the WHOLE countdown just to continue, even when
                # nothing needs changing, is needless waiting - ENTER
                # should skip straight to the unattended boot instead.
                # Distinguishing a real Enter from a genuine timeout
                # (both leave $key empty) needs the read's own exit
                # status, not just the value: this tty's termios has
                # `icrnl` on (confirmed via `stty -a` - the default,
                # never touched by this file), so the kernel translates
                # an incoming CR to LF before this ever sees it, and
                # `read -n 1` hitting that line-delimiter byte returns
                # SUCCESS (rc 0) with an EMPTY key (the delimiter itself
                # is consumed, not stored) - confirmed directly against
                # a real pty. A genuine timeout ALSO leaves key empty,
                # but returns NONZERO. Any OTHER single keystroke
                # (confirmed: a bare, un-Enter-terminated character
                # arrives on its own, non-empty key, rc 0 - the same
                # real pty behavior this whole reader already relies on
                # for bare TAB) is neither of these and falls through
                # unchanged - still correctly ignored without ending
                # this console's own listening window, exactly
                # preserving the earlier "ESC then TAB" fix (a stray
                # keystroke before the real one must never kill the
                # reader).
                if [ "$_read_rc" -eq 0 ] && [ -z "$key" ] \
                    && { [ "$noisy" -eq 0 ] || case " $trusted " in *" $tty_dev "*) true ;; *) false ;; esac; }; then
                    : > "$tmpdir/ENTER_PRESSED"
                    break
                fi
                remaining=$((deadline - $(date +%s)))
                [ "$remaining" -le 0 ] && break
            done
        ) &
        pids="$pids $!"
    done

    i=0
    winner=""
    while [ "$i" -lt "$timeout" ] && [ -z "$winner" ]; do
        for tty_dev in $ttys; do
            printf '\ralpine-zfsboot starting, press TAB to interrupt (%ds) or ENTER to continue now ' \
                "$((timeout - i))" > "$tty_dev" 2>/dev/null
        done
        for tty_dev in $ttys; do
            if [ -e "$tmpdir/$(_tty_safe_name "$tty_dev")" ]; then
                winner="$tty_dev"
                break
            fi
        done
        [ -n "$winner" ] && break
        # ENTER on ANY listened console collapses the remaining wait to
        # zero - same outcome as the timeout elapsing naturally (no
        # winner, unattended boot proceeds), just without actually
        # waiting for it. Deliberately checked AFTER the per-console
        # winner check above, same ordering reasoning as everywhere
        # else in this function: a real TAB always takes priority over
        # a merely-impatient ENTER if both somehow land the same tick.
        [ -e "$tmpdir/ENTER_PRESSED" ] && break
        sleep 1
        i=$((i + 1))
    done
    # One last check after the loop - a background reader can win in
    # the final real second before `timeout` itself elapses, which the
    # `i`-driven loop above may not get to re-poll for.
    if [ -z "$winner" ]; then
        for tty_dev in $ttys; do
            if [ -e "$tmpdir/$(_tty_safe_name "$tty_dev")" ]; then
                winner="$tty_dev"
                break
            fi
        done
    fi

    for pid in $pids; do kill "$pid" 2>/dev/null; done
    wait 2>/dev/null
    for tty_dev in $ttys; do printf '\r%78s\r' "" > "$tty_dev" 2>/dev/null; done
    enter_pressed=0
    [ -z "$winner" ] && [ -e "$tmpdir/ENTER_PRESSED" ] && enter_pressed=1
    rm -rf "$tmpdir"
    if [ -n "$winner" ]; then
        echo "$winner"
        return 0
    fi
    # ENTER: no edit screen and no console information at all - the caller
    # treats it exactly like a timeout that arrived sooner.
    if [ "$enter_pressed" -eq 1 ]; then
        return 2
    fi
    return 1
}

# _boot_args_default_line TTY OPTS - the line pre-filled into the edit
# screen: every alpine-zfsboot.* token ALREADY on the real kernel
# cmdline, verbatim (so the operator edits exactly what's really
# there, nothing synthesized) - plus an explicit console=TTY[,OPTS],
# only when cmdline didn't already name one itself, so there is always
# something concrete and correct to look at, never a blank line
# pretending nothing is configured. TTY/OPTS are passed in explicitly by
# the caller (_boot_args_interrupt()): the console the CONFIG names
# (EFI/ALPINE/config), or the resolved default when none is configured -
# never the console TAB happened to be pressed on. Echoes the line; reads
# $ROOTFS/proc/cmdline (same ROOTFS-prefix convention the real
# cmdline-parsing loop near the top of this file already
# uses).
_boot_args_default_line() {
    tty="$1"
    opts="$2"
    default_line=""
    for arg in $(cat "$ROOTFS/proc/cmdline" 2>/dev/null); do
        case "$arg" in
            alpine-zfsboot.*) default_line="$default_line $arg" ;;
        esac
    done
    # The configured console is always SHOWN, even a name select_console()
    # would not recognize (a hand-edited ttyS3/hvc0): hiding it would make
    # the operator think nothing is configured. Confirming the line
    # unchanged is a no-op, so showing it can never apply it.
    case " $default_line " in
        *" alpine-zfsboot.console="*) : ;;
        *)
            [ -n "$tty" ] && default_line="$default_line alpine-zfsboot.console=$tty${opts:+,$opts}"
            ;;
    esac
    echo "${default_line# }"
}

_boot_args_interrupt() {
    # Every REGISTERED console (same source notify_inactive_consoles()
    # uses, same reasoning - see that function's own comment: these are
    # the ones the kernel's own console= parsing already gave correct
    # line settings to), PLUS _extra_relevant_consoles() (see its own
    # comment - the persisted FAT-config preference AND the
    # already-resolved $ACTIVE_TTY, even when NOT kernel-registered) -
    # NOT just whichever one select_console() picked as primary. Real
    # incident that found the "registered only" gap the hard way: a
    # VGA-only Proxmox console, kernel default (back when this build
    # still baked a second, unconfigured console= onto every cmdline -
    # see build.sh's own CONSOLE_CMDLINE comment on why it no longer
    # does) resolved to ttyS0, so a single-console prompt here printed
    # on ttyS0 only - invisible to an operator who only ever had tty0.
    # The build itself now bakes in ONLY tty0 by default, so that
    # specific incident shape can't recur from the default build alone -
    # but an operator who HAS configured a real serial console (FAT
    # config, or an explicit cmdline/EXTRA_CMDLINE override) still
    # deserves to see this prompt there too, not just on tty0. No
    # separate "real boot only" ROOTFS guard needed (unlike this
    # function's own earlier, single-console version) - under
    # tests/run-tests.sh, a fake $ROOTFS/dev/$tty that isn't a real
    # char device (or no $ROOTFS/sys/class/tty/console/active at all,
    # and no extra console either) naturally makes $ttys empty, and the
    # very next line already returns 0 for that; a test that DOES want
    # to exercise this for real symlinks a fake $ROOTFS/dev/<name> at a
    # real pty instead (see tests/run-tests.sh's own note on that).
    #
    # `-c` (node exists) alone, like round 2's own first attempt at the
    # TAB-typed-value check, was a bug here
    # too: a PORT_UNKNOWN node (exists, opens fine, every actual read
    # fails EIO) got added to the poll list, and the backgrounded
    # reader's own retry loop (see _boot_args_wait_for_tab's own
    # comment) then spins at full speed for the ENTIRE countdown - read
    # fails instantly, doesn't match TAB, loop immediately re-reads -
    # measured directly at several THOUSAND iterations/second in PID
    # 1's own child. A later review found this exact bug had only
    # ever been fixed on _extra_relevant_consoles()'s own side (the
    # `stty -g` gate there) - this registered-console loop, right next
    # to it, still only checked `-c`. The legacy 8250 UART driver
    # registers every nr_uarts line as PORT_UNKNOWN whether or not real
    # hardware is behind it, so a kernel cmdline naming more serial
    # consoles than physically exist can register a genuinely dead one
    # here just as easily as the FAT-pref/cmdline path could. Same gate
    # now applied to both.
    ttys=""
    for tty in $(cat "$ROOTFS/sys/class/tty/console/active" 2>/dev/null); do
        [ -c "$ROOTFS/dev/$tty" ] || continue
        ( stty -g < "$ROOTFS/dev/$tty" ) >/dev/null 2>&1 || continue
        ttys="$ttys $ROOTFS/dev/$tty"
    done
    trusted="$ttys"
    _parse_console_spec "$(read_fat_console_pref)"
    _fat_t="$_CONSOLE_SPEC_TTY"
    for tty in $(_extra_relevant_consoles); do
        case " $ttys " in
            *" $ROOTFS/dev/$tty "*) : ;;
            *) ttys="$ttys $ROOTFS/dev/$tty" ;;
        esac
        { [ "$tty" = "$ACTIVE_TTY" ] || [ "$tty" = "$_fat_t" ]; } && trusted="$trusted $ROOTFS/dev/$tty"
    done
    ttys="${ttys# }"
    [ -n "$ttys" ] || return 0

    # Validated HERE, at use time, not where it's parsed - same
    # established convention as bootcheck_max's own validation (see
    # attempt_pool_import()'s own comment on that) - a malformed
    # alpine-zfsboot.interrupt_timeout= (a typo, a CR-mangled hand-edit
    # of the ESP config) must never reach the arithmetic/comparison
    # inside _boot_args_wait_for_tab() unvalidated: that runs in PID 1
    # itself, before pool import, on every single boot - a crash there
    # is far worse than a crash almost anywhere else in this file.
    case "$BOOT_ARGS_TIMEOUT" in
        ''|*[!0-9]*)
            [ -n "$BOOT_ARGS_TIMEOUT" ] && msg "WARNING: invalid alpine-zfsboot.interrupt_timeout=$BOOT_ARGS_TIMEOUT, using the default (15)"
            BOOT_ARGS_TIMEOUT=15
            ;;
        *)
            if [ "$BOOT_ARGS_TIMEOUT" -gt 60 ]; then
                msg "WARNING: alpine-zfsboot.interrupt_timeout=$BOOT_ARGS_TIMEOUT out of range (0-60), using the default (15)"
                BOOT_ARGS_TIMEOUT=15
            fi
            ;;
    esac
    [ "$BOOT_ARGS_TIMEOUT" -eq 0 ] && return 0

    # show which console is ALREADY active
    # and WHERE that choice came from, printed once (a plain newline-
    # terminated line, not part of the repeating \r-redrawn countdown
    # _boot_args_wait_for_tab() prints below it) before the countdown
    # starts - so an operator watching any listened console immediately
    # understands "this is what's configured, TAB here to change it"
    # instead of having to infer it from silence or trial and error.
    # Re-derived here rather than tracked as new global state from
    # select_console() - same values that function itself already
    # computed from, just asked again for display purposes.
    _parse_console_spec "$ZFSBOOT_CONSOLE_CMDLINE"
    if [ -n "$_CONSOLE_SPEC_TTY" ] && [ "$_CONSOLE_SPEC_TTY" = "$ACTIVE_TTY" ]; then
        _console_source="cmdline/TAB-interrupt, this boot only"
    else
        _parse_console_spec "$(read_fat_console_pref)"
        if [ -n "$_CONSOLE_SPEC_TTY" ] && [ "$_CONSOLE_SPEC_TTY" = "$ACTIVE_TTY" ]; then
            _console_source="EFI/ALPINE/config, persisted"
        else
            _console_source="kernel default"
        fi
    fi
    # Same two gates the main loop dies on: CONSOLE_UNUSABLE, and a selected
    # node that exists but cannot be opened (PORT_UNKNOWN serial).
    _unusable="$CONSOLE_UNUSABLE"
    if [ -z "$_unusable" ] && [ -n "$ACTIVE_TTY" ] \
        && ! ( stty -g < "$ROOTFS/dev/$ACTIVE_TTY" ) >/dev/null 2>&1; then
        _unusable="/dev/$ACTIVE_TTY ($_console_source) cannot be opened this boot"
    fi
    for tty_dev in $ttys; do
        if [ -n "$_unusable" ]; then
            printf 'alpine-zfsboot: WARNING: %s - the boot will STOP in the recovery shell unless you press TAB and change it\n' \
                "$_unusable" > "$tty_dev" 2>/dev/null
        else
            printf 'alpine-zfsboot: current console is /dev/%s (%s)\n' \
                "$ACTIVE_TTY" "$_console_source" > "$tty_dev" 2>/dev/null
        fi
    done

    tty_dev="$(_boot_args_wait_for_tab "$ttys" "$BOOT_ARGS_TIMEOUT" "$trusted")"
    _wait_rc=$?
    [ "$_wait_rc" -eq 1 ] && return 0

    # ENTER (rc 2) only ends the wait early - it is exactly a timeout that
    # arrived sooner: no edit screen, and NO console change. Which console
    # is used is decided by the layers in select_console() (kernel default <
    # EFI/ALPINE/config < cmdline); only a confirmed edit on the TAB screen
    # overrides them.
    [ "$_wait_rc" -eq 2 ] && return 0
    # The console the key was pressed on only decides where the edit screen
    # is DRAWN (and its TERM). It never decides what the screen proposes.
    tty="${tty_dev##*/}"

    # TERM for the dialog calls below specifically - nothing sets $TERM
    # at all until the main loop runs, well after this function
    # returns - plus real terminal geometry for a serial winner, since
    # a raw serial line carries no window-size negotiation of its own
    # (same "TIOCGWINSZ can report 0x0/stale" problem the main loop's
    # own comment, further down, documents and fixes for ITS OWN dialog
    # calls, once a console is actually selected). A gap here
    # would be easy to miss: tty0, where both of these are already
    # correct, is the usual place to press TAB, so a serial winner is the
    # path that needs them. No extra baud/parity call is needed here
    # though - every possible winner already has correct line settings
    # by this point, either from the kernel's own console= parsing
    # (anything from the kernel-registered loop above) or from this
    # function's own fix, above, for the FAT-pref case specifically.
    case "$tty" in
        tty0) dialog_term=linux ;;
        *)
            dialog_term=ansi
            stty rows 24 cols 80 < "$tty_dev" > "$tty_dev" 2>/dev/null
            ;;
    esac

    # Tell every OTHER console where the edit screen is, so a boot that now
    # waits on it never looks hung elsewhere.
    for _o in $ttys; do
        [ "$_o" = "$tty_dev" ] || printf 'alpine-zfsboot: TAB pressed - the edit screen is open on /dev/%s\n' "$tty" > "$_o" 2>/dev/null
    done

    # The proposed console= is what the CONFIG says (EFI/ALPINE/config), not
    # the console TAB happened to be pressed on - pressing TAB and confirming
    # unchanged must keep the configured console. With no config, the
    # resolved default (kernel's console). A cmdline console= already on the
    # kernel cmdline is kept as-is by _boot_args_default_line.
    _parse_console_spec "$(read_fat_console_pref)"
    if [ -n "$_CONSOLE_SPEC_TTY" ]; then
        default_line="$(_boot_args_default_line "$_CONSOLE_SPEC_TTY" "$_CONSOLE_SPEC_OPTS")"
    else
        default_line="$(_boot_args_default_line "$ACTIVE_TTY" "$ACTIVE_CONSOLE_OPTS")"
    fi
    # $ROOTFS-prefixed (empty at a real boot, so byte-identical to the
    # old hardcoded /tmp/alpine-zfsboot/boot-args-edit there) rather
    # than hardcoded - lets tests exercise this for real against a fake
    # root instead of only via a static source check, and can never
    # collide with an unrelated file some OTHER program left sitting at
    # the real, bare /tmp/alpine-zfsboot path.
    out_file="$ROOTFS/tmp/alpine-zfsboot/boot-args-edit"
    mkdir -p "${out_file%/*}" 2>/dev/null
    # A console= that names no real /dev node is never applied silently
    # - it's rejected, with the operator given an explicit choice: fix
    # it (same inputbox, edits preserved - "edit again"), or confirm
    # they genuinely want it anyway (the device may appear later, e.g.
    # after a hotplug) via a real, separate confirmation, never a
    # default. Two things this is DELIBERATELY not: (1) a prior version
    # of this screen applied the bad value anyway and just noted
    # "falling back to the kernel default" - a typo got silently
    # swallowed and dressed up as a warning, exactly what an operator
    # pressing TAB to take control does NOT want; (2) a hard block with
    # no way out at all - an operator who knows the device will exist
    # later needs an explicit way to say so. --yesno (not --yes-label/
    # --no-label, whose availability in whatever dialog build ships
    # here isn't confirmed - a silently-unrecognized flag would exit
    # non-zero and make "force" permanently unreachable) with the
    # question itself spelling out what each button means, so plain
    # "Yes"/"No" labels are unambiguous either way. select_console()'s
    # own boot-log WARNING (see its comment) still fires for a forced
    # console that never shows up - that's not the silent fallback this
    # replaces, it's the exact on-screen confirmation the operator asked
    # for to know their forced choice didn't pan out.
    original_line="$default_line"
    while :; do
        TERM="$dialog_term" dialog --ascii-lines --backtitle "alpine-zfsboot" --inputbox \
            "Boot arguments (alpine-zfsboot.key=value, space-separated - this boot only; edit EFI/ALPINE/config on the ESP to persist):" \
            10 70 "$default_line" \
            < "$tty_dev" > "$tty_dev" 2>"$out_file"
        status=$?
        edited="$(cat "$out_file" 2>/dev/null)"
        rm -f "$out_file"
        TERM="$dialog_term" clear > "$tty_dev" 2>/dev/null || true
        [ "$status" -eq 0 ] || return 0
        # Nothing typed -> nothing changes (the proposed line is only a view
        # of the config/cmdline, confirming it unchanged must not turn it into
        # an override).
        [ "$edited" = "$original_line" ] && return 0

        typed_console=""
        for arg in $edited; do
            case "$arg" in
                alpine-zfsboot.console=*) typed_console="${arg#alpine-zfsboot.console=}" ;;
            esac
        done
        if [ -n "$typed_console" ]; then
            _parse_console_spec "$typed_console"
            # A real, reported bug: checking only `-c` (the node
            # EXISTS) let a device through here that the main loop's
            # own later open-test (see its comment, further down -
            # `stty -g`, not just a bare existence check, because
            # /dev/ttyS1-3-shaped nodes commonly exist with no real
            # UART behind them - PORT_UNKNOWN, confirmed on real
            # hardware AND on a real Proxmox guest's unattached
            # serial0) then silently rejected anyway, with nothing but
            # a kmsg line to explain it - the exact "accepted here,
            # silently dropped two screens later" mismatch an operator
            # has no way to notice in time. Using the SAME `stty -g`
            # test here that decides it later means this screen's
            # yes/no choice is the actual, final answer - not a weaker
            # pre-check that can still be overruled downstream without
            # telling anyone.
            #
            # A second instance of the exact same
            # "accepted here, dropped there" shape: `stty -g` alone
            # accepts ANY openable device, but select_console()'s own
            # candidate list (_known_console_names, see its own
            # comment) only ever recognizes a small, fixed set of
            # names. A genuinely live, openable ttyS3/ttyAMA1/hvc0
            # would pass THIS check, get applied, and then get dropped
            # by select_console() anyway - with a warning that
            # incorrectly claims the device doesn't exist, when it does
            # and works fine, it's just a name this build doesn't treat
            # as a console candidate at all. Checking the same name
            # list here too means this screen's choice is final either
            # way, and an operator who hits this gets the honest
            # force-or-edit choice instead of a confusing, factually
            # wrong warning two screens later.
            if [ -n "$_CONSOLE_SPEC_TTY" ] && { ! _is_known_console_name "$_CONSOLE_SPEC_TTY" || ! ( stty -g < "$ROOTFS/dev/$_CONSOLE_SPEC_TTY" ) >/dev/null 2>&1; }; then
                TERM="$dialog_term" dialog --ascii-lines --backtitle "alpine-zfsboot" --yesno \
                    "/dev/$_CONSOLE_SPEC_TTY isn't usable this boot (not a supported console name, missing, or present but not openable) - alpine-zfsboot.console=$typed_console names it anyway.\n\nYes = use it anyway (if it still cannot be opened after pool import, the boot stops in the recovery shell)\nNo  = go back and edit" \
                    10 70 < "$tty_dev" > "$tty_dev" 2>/dev/null
                force=$?
                TERM="$dialog_term" clear > "$tty_dev" 2>/dev/null || true
                if [ "$force" -ne 0 ]; then
                    default_line="$edited"
                    continue
                fi
            fi
        fi
        break
    done

    # The edited line IS the cmdline layer now: a console= token the operator
    # deleted must stop applying too.
    ZFSBOOT_CONSOLE_CMDLINE=""
    ZFSBOOT_KV_SOURCE=cmdline
    for arg in $edited; do
        apply_zfsboot_kv "$arg"
    done
    ZFSBOOT_KV_SOURCE=""
}

# Remote rescue access is NOT started here unconditionally anymore -
# see rescue-ssh.sh's own header comment for the full lifecycle
# rationale. die() below is one of this project's three real trigger
# points (the other two are boot-dataset.sh's fail() and its
# encryption-key wait) - each calls start_rescue_ssh ITSELF, at the
# exact moment its own specific problem is detected, not from a single
# early guess up here. A healthy boot that never calls die() never
# starts dropbear at all: no open port, nothing to scan, nothing to
# harden, because it isn't there - even when authorized_keys/host key
# ARE staged for break-glass use.

modprobe zfs 2>/dev/null
# Not fatal here if this fails - `zpool import` below fails with a real,
# specific error message either way, which is more useful than dying on
# a modprobe warning that might just mean the module was built in.

# -f: confirmed necessary for this project to boot AT ALL, not just
# to recover from an earlier crash - this initramfs is fresh every
# boot (no persisted /etc/hostid across reboots), so the pool's own
# recorded hostid essentially never matches this boot's, and zpool
# import refuses ("pool was previously in use from another system")
# without -f on every normal reboot, not just an unclean one. The
# real protection -f bypasses (the SAME pool imported live on two
# hosts at once, e.g. shared SAN/iSCSI storage) doesn't apply here:
# $POOL lives on this machine's own local disk, one importer, one
# machine, by construction - not the scenario that check exists for.
# A missing/unbootable pool used to `die` straight to a bare recovery
# shell here, before menu.py ever got a chance to run at all - a real,
# reported usability problem: a bare bash prompt gives no indication
# of WHAT went wrong or WHAT ELSE is available (Diagnostics, Network,
# a properly job-control-capable Recovery shell, retrying a different
# pool via Deploy) short of already knowing the right zfs/zpool
# incantations by heart. This is exactly the scenario menu.py's own
# rich UI exists for - it and boot-dataset.sh's own fail() are the two
# places actually meant to be someone's first real look at a broken
# boot, not this script's own bare-bash fallback (still kept below,
# but only as the last resort if python3/menu.py itself is what's
# broken). ALPINE_ZFSBOOT_POOL_IMPORT_ERROR, once set, is what tells menu.py
# to show that state instead of assuming a normal, bootable pool.
#
# A function, not inline - real operator gap found live: a pool-import
# failure caused by something genuinely fixable from the Recovery shell
# (a real case: an ambiguous stale pool label from an old install,
# `zpool import` refusing to guess between two same-named pools) left
# an operator who fixed it BY HAND in there (zpool labelclear, then
# their own manual zpool import) with no way back to a working boot
# short of a full hardware reboot - exiting the shell just relaunched
# menu.py, which still only had the FROZEN, already-failed
# ALPINE_ZFSBOOT_POOL_IMPORT_ERROR from before they fixed anything
# (this whole block used to run exactly once, here, before the
# menu.py loop even starts). recovery_shell()'s own new exit(43)
# convention (see its own comment in menu.py) now calls this same
# function again on the way back - re-collecting a real, FRESH result
# instead of replaying the stale one. Safe to call more than once in
# the same boot: start_rescue_ssh is documented idempotent (see its
# own header comment), and the bootcheck block below only ever READS
# org.alpinezfsboot:bootcheck - boot-dataset.sh is the ONE place that
# ever increments it (see that file's own comment on this), so
# re-running this function's own read-and-decide logic can't
# double-count a real attempt.
attempt_pool_import() {
    POOL_IMPORT_ERROR=""

    msg "importing pool: $POOL"
    # zpool list, not just "try import and see": a retry (see this
    # function's own header comment) can find $POOL ALREADY imported -
    # either because the operator's own manual `zpool import` (the
    # exact motivating case) already did it, or because the FIRST call
    # this boot already imported it fine and only failed the later
    # bootfs check below. `zpool import` itself then fails with "a pool
    # with that name already exists" - `-f` does not override this, it
    # only overrides the in-use-by-another-system hostid check - which
    # would make a retry report a NEW, misleading failure right after
    # the operator did everything right. Confirmed the hard way by a
    # real adversarial review of this exact function: both real retry
    # paths (manual import in the recovery shell, and the no-bootfs
    # case where THIS function's own first call already imported the
    # pool before failing) hit this.
    if zpool list -H -o name "$POOL" >/dev/null 2>&1; then
        msg "pool $POOL is already imported"
    elif ! zpool import -f -N -d /dev "$POOL" 2>/tmp/zpool-import.log; then
    cat /tmp/zpool-import.log
    POOL_IMPORT_ERROR="zpool import -f -N -d /dev $POOL failed: $(cat /tmp/zpool-import.log | tr '\n' ' ')"
    msg "WARNING: $POOL_IMPORT_ERROR"
fi

if [ -z "$POOL_IMPORT_ERROR" ]; then
    BOOTFS="$(zpool get -H -o value bootfs "$POOL" 2>/dev/null)"
    if [ -z "$BOOTFS" ] || [ "$BOOTFS" = "-" ]; then
        POOL_IMPORT_ERROR="pool $POOL has no bootfs property set (zpool get bootfs $POOL)"
        msg "WARNING: $POOL_IMPORT_ERROR"
    else
        export ALPINE_ZFSBOOT_BOOTFS="$BOOTFS"
        # Mirrored boot: does the pool belong to the installation the ESP
        # config came from? A warning only (esp-select.sh).
        esp_check_pool_identity "$POOL"
        # `zpool status -x POOL` prints "pool 'POOL' is healthy" when
        # everything is fine, or a real problem description (DEGRADED,
        # FAULTED, a resilver in progress, ...) otherwise. menu.py's own
        # Diagnostics screen surfaces this too, but a WARNING here means
        # it's visible immediately, before anyone even has to think to
        # go looking for it.
        health="$(zpool status -x "$POOL" 2>/dev/null)"
        case "$health" in
            *healthy*) ;;
            *) msg "WARNING: $POOL is not healthy: $health" ;;
        esac
    fi
fi
export ALPINE_ZFSBOOT_POOL_IMPORT_ERROR="$POOL_IMPORT_ERROR"

# A real, confirmed gap: this project's own header comment above
# already documents "three real trigger points" for start_rescue_ssh -
# die()'s own call, boot-dataset.sh's fail(), and the encryption-key
# wait - but a pool-import failure specifically, the single most
# catastrophic failure this project can hit, was NOT one of them. On
# the actual COMMON path (menu.py itself runs fine and just renders the
# POOL_IMPORT_ERROR state instead of a normal countdown - see menu.py's
# own POOL_IMPORT_ERROR handling in main()), die() below is NEVER
# reached at all (it's the last-resort fallback for when python3/
# menu.py itself is ALSO broken) - meaning nothing ever called
# start_rescue_ssh, and a headless machine with real authorized_keys/
# host key staged and a real NIC sat there with menu.py rendering a nice
# error screen to a console nobody could see, and nothing listening on
# port 22. Fixed here, proactively, the moment the failure is known -
# not reactively inside menu.py (which has no direct way to call this
# shell function at all) and not left to die()'s own fallback-only path.
if [ -n "$POOL_IMPORT_ERROR" ]; then
    start_rescue_ssh
fi

# Failed-boot detection ("bootcheck") - see boot-dataset.sh's own
# header comment on the property grammar and content-derived-arming
# design for the full why. This is the ONE authoritative decision
# point: read the per-BE state, decide, and set a single exported flag
# that every auto-boot path (this script's own fallback further down,
# and menu.py's countdown/exception-handler fallback) checks - not
# three separate copies of the same decision drifting apart.
#
# Skipped entirely if the pool itself never imported (POOL_IMPORT_ERROR
# already set above - a wholly separate, already-handled failure class
# with its own immediate, counter-free rescue trigger) or if
# alpine-zfsboot.bootcheck=off was configured for this one boot.
ALPINE_ZFSBOOT_FORCED_RESCUE=""
if [ -z "$POOL_IMPORT_ERROR" ] && [ "$ALPINE_ZFSBOOT_BOOTCHECK" != "off" ]; then
    bootcheck_raw="$(zfs get -H -o value,source org.alpinezfsboot:bootcheck "$BOOTFS" 2>/dev/null)"
    bootcheck_value="${bootcheck_raw%%	*}"
    bootcheck_source="${bootcheck_raw#*	}"
    bootcheck_k=""
    case "$bootcheck_value" in
        armed:*)
            bootcheck_k="${bootcheck_value#armed:}"
            case "$bootcheck_k" in
                ''|*[!0-9]*) bootcheck_k="" ;;
            esac
            ;;
    esac
    # Only a LOCAL, numeric armed:K counts as a real per-BE attempt
    # count - a real, confirmed ZFS behavior: user properties are
    # ALWAYS inherited, so a value set higher in the pool hierarchy
    # (e.g. on the ROOT container dataset) would otherwise silently
    # apply the exact same stale count to every BE and every future
    # clone. Anything else (absent, off, unparseable, inherited,
    # received) is simply not counted here - fail open, matching this
    # project's own established posture for every other malformed-
    # input case.
    if [ -n "$bootcheck_k" ] && [ "$bootcheck_source" = "local" ]; then
        bootcheck_max="$ALPINE_ZFSBOOT_BOOTCHECK_MAX"
        case "$bootcheck_max" in
            ''|*[!0-9]*|0)
                [ -n "$bootcheck_max" ] && msg "WARNING: invalid alpine-zfsboot.bootcheck.max=$bootcheck_max, using the default (3)"
                bootcheck_max=3
                ;;
            *)
                if [ "$bootcheck_max" -gt 99 ]; then
                    msg "WARNING: alpine-zfsboot.bootcheck.max=$bootcheck_max out of range (1-99), using the default (3)"
                    bootcheck_max=3
                fi
                ;;
        esac
        if [ "$bootcheck_k" -ge "$bootcheck_max" ]; then
            msg "WARNING: $BOOTFS has $bootcheck_k consecutive un-confirmed boot attempts (threshold $bootcheck_max) - attempting rescue SSH before deciding"
            # Gated on whether rescue SSH ACTUALLY started, not merely
            # on whether authorized_keys/host key are staged -
            # start_rescue_ssh can still fail after both are present
            # (host key fails to validate, net_config itself failing, a
            # malformed ssh.allow= CIDR) - see rescue-ssh.sh's own
            # return-status contract. Deciding "material staged
            # therefore safe to stop auto-booting"
            # would strand exactly the headless machine this feature
            # exists to protect, in exactly the scenario where it
            # matters most.
            if start_rescue_ssh; then
                ALPINE_ZFSBOOT_FORCED_RESCUE="$BOOTFS has $bootcheck_k consecutive un-confirmed boot attempts (threshold $bootcheck_max)"
            elif [ "$ALPINE_ZFSBOOT_BOOTCHECK" = "force" ]; then
                msg "WARNING: rescue SSH did not start, but alpine-zfsboot.bootcheck=force is set - staying in rescue anyway"
                ALPINE_ZFSBOOT_FORCED_RESCUE="$BOOTFS has $bootcheck_k consecutive un-confirmed boot attempts (threshold $bootcheck_max) - rescue SSH unreachable, forced anyway"
            else
                msg "WARNING: rescue SSH did not start and no force override - auto-booting $BOOTFS anyway rather than stranding this machine unreachably"
            fi
        elif [ "$bootcheck_k" -gt 0 ]; then
            msg "WARNING: $BOOTFS has $bootcheck_k consecutive un-confirmed boot attempt(s) (threshold $bootcheck_max) - auto-booting anyway"
        fi
    fi
fi
export ALPINE_ZFSBOOT_FORCED_RESCUE
}

# select_console() resolves Layers 1-2 (kernel default, FAT config) so
# ACTIVE_TTY/ACTIVE_CONSOLE_OPTS reflect the real, already-resolved
# default BEFORE _boot_args_interrupt() runs - it needs that for its
# own default-line suggestion (see its own comment), even though it
# polls/prints on every registered console, not just this one. Its own
# Layer 3 read (cmdline) is a harmless no-op this early (cmdline was
# already parsed above, nothing has changed since). The main loop below
# calls select_console() again itself before ever actually attaching
# to a console - this first call is only for _boot_args_interrupt()'s
# own benefit.
select_console
_boot_args_interrupt

attempt_pool_import

# Worth importing any OTHER pool that's reachable right now too (e.g.
# a second disk plugged in for a rescue, or a golden-image source
# pool) - best-effort, so menu.py's boot-environment listing/deploy
# flows can see it. `zpool import -d /dev` with no pool name lists
# every importable pool as "   pool: NAME" blocks. Once, here, not
# inside the loop below - console switches don't change what pools are
# reachable.
for extra in $(zpool import -d /dev 2>/dev/null | sed -n 's/^   pool: //p'); do
    [ "$extra" = "$POOL" ] && continue
    zpool import -f -N -d /dev "$extra" 2>/dev/null
done

export ALPINE_ZFSBOOT_MENU_TIMEOUT="$MENU_TIMEOUT"
export ALPINE_ZFSBOOT_MENU_GRACE="$MENU_GRACE"

# menu.py always runs now (see this file's own header comment) - the
# loop, not a single run, is what makes recovery_shell()'s own exit(43)
# convention (see its own comment there and in the case statement
# below) actually re-run attempt_pool_import() and come back around to
# a fresh menu.py, rather than needing a full reboot to see a pool fix
# made by hand. Any OTHER exit (0, or nonzero from a real crash) breaks
# out and falls through to automatic boot below, exactly as a crash
# always has.
while :; do
    select_console
    # Real boot only (bare /dev, no $ROOTFS prefix) - under
    # tests/run-tests.sh, ROOTFS is set and this exec would hijack the
    # test harness's own output-capturing redirect instead of anything
    # meaningful, so it's skipped there; the test only needs
    # ACTIVE_TTY itself, not the physical redirect.
    if [ -z "$ROOTFS" ]; then
        # An adversarial review of the operator-remote-
        # console-selection feature (select_console()'s own layers 2-4)
        # found a real, serious hole this closes: `exec <
        # "/dev/$ACTIVE_TTY"` below is the actual `exec` special
        # builtin, and POSIX/busybox ash both exit the WHOLE (non-
        # interactive) shell outright if that redirection fails - which
        # it genuinely can, since /dev/ttyS1-3 nodes commonly EXIST on
        # real x86 hardware even with no real UART wired to them
        # (PORT_UNKNOWN, confirmed against a real system's own
        # /sys/class/tty/ttyS*/type) - select_console()'s own candidate
        # filter only checks the node EXISTS, not that opening it
        # actually works. PID 1 exiting for ANY reason is an
        # unrecoverable "Attempted to kill init!" kernel panic, not a
        # survivable error - this file never bare-`exec`s onto a device
        # it hasn't already open-tested in a subshell first (a
        # redirection failure inside `( ... )` only fails THAT
        # subshell, not this one - confirmed directly: `busybox ash -c
        # 'exec < /nonexistent; echo SURVIVED'` never prints and exits
        # nonzero, but wrapping the same redirection in a subshell
        # first and checking its exit status does not bring this shell
        # down).
        #
        # PR #16 review (F1), confirmed against a real kernel: a plain
        # `: < "/dev/$tty"` open only fails for a node with no driver
        # registered at all (ENXIO) - it SUCCEEDS on exactly the
        # PORT_UNKNOWN case this comment describes (8250 registers all
        # nr_uarts lines as PORT_UNKNOWN nodes that open fine; only
        # writes/ioctls on them return EIO). `stty -g` actually
        # exercises the line (a termios ioctl), so it fails with EIO on
        # PORT_UNKNOWN too, while still succeeding on tty0, ptys, and a
        # real working UART.
        #
        # An earlier version of this block, on open-test failure,
        # silently substituted KERNEL_ACTIVE_TTY (the kernel's own live
        # /dev/console, guaranteed to work) and continued a normal boot
        # there instead - that is exactly the same "configured one console, booted
        # silently on a different one" shape this whole console-
        # selection feature exists to eliminate everywhere else (the
        # Netcup incident; an earlier ttyS0-accepted-but-tty0-
        # shown bug). An operator who configured ttyS0 specifically
        # because THAT's the channel they're actually watching (SOL,
        # IPMI) would see nothing at all, while bootcheck/rc.log record
        # an ordinary successful boot on tty0 instead - invisible
        # failure, not a safe recovery. The design principle: no silent surprises, and exactly ONE
        # recovery path for a boot that can't do what it was told -
        # the rescue-SSH/recovery-shell route die() already provides
        # (start_rescue_ssh if staged, _recovery_shell either way, PID
        # 1 survives) - not a second, quieter path that tries to paper
        # over the problem instead of surfacing it. Physical/unattended
        # hardware is expected to carry its own independent out-of-band
        # access (Serial-over-LAN, a hosting provider's own rescue
        # mode) for exactly this case; alpine-zfsboot.console= is
        # expected to always be kept pointed at a channel that actually
        # works, not discovered-and-corrected at boot time.
        # One rule for every way an operator-chosen console can fail
        # (missing node, unsupported name, present-but-dead node): stop in
        # die() (rescue SSH + recovery shell), never boot on a different
        # console than the one that was asked for.
        if [ -n "$CONSOLE_UNUSABLE" ]; then
            die "$CONSOLE_UNUSABLE - not falling back to a different console silently; fix alpine-zfsboot.console= (EFI/ALPINE/config on the ESP) via the rescue-SSH/recovery-shell session this just started, or via its own out-of-band access (Serial-over-LAN, rescue mode)"
        fi
        if ! ( stty -g < "/dev/$ACTIVE_TTY" >/dev/null 2>&1 ); then
            die "/dev/$ACTIVE_TTY (the selected console) could not be opened - not falling back to a different console silently; fix alpine-zfsboot.console= (EFI/ALPINE/config on the ESP) via the rescue-SSH/recovery-shell session this just started, or via its own out-of-band access (Serial-over-LAN, rescue mode)"
        fi
        notify_inactive_consoles
        exec < "/dev/$ACTIVE_TTY" > "/dev/$ACTIVE_TTY" 2>&1
    else
        notify_inactive_consoles
    fi

    # dialog (menu.py's own rendering - see its header comment) needs
    # $TERM to resolve to a real terminfo entry - confirmed missing
    # the hard way (`setupterm: could not find terminfo database`,
    # TERM unset falls back to "unknown", which no terminfo database
    # has an entry for either way). tty0 is a real Linux virtual
    # console - "linux" is its own terminfo entry, baked into every
    # real Linux install for exactly this device, and does declare
    # color support. ttyS0/ttyAMA0 are real serial lines - NOT "vt100"
    # (an earlier version used that - confirmed for real via `infocmp
    # vt100` that its terminfo entry declares no colors/pairs/setaf
    # capability at all: real DEC VT100 hardware was monochrome, and
    # the terminfo database reflects that literally, which is exactly
    # why this project's own green-on-black dialog theme - see
    # init/dialogrc - never showed any color over serial at all).
    # "ansi" instead: confirmed via `infocmp ansi` to declare real
    # color support (colors#8, setaf) AND proper cursor/arrow-key
    # capabilities dialog's own menu navigation needs, while still
    # being about as conservatively-compatible a choice as "vt100" was
    # for an unknown real serial terminal on the other end.
    case "$ACTIVE_TTY" in
        tty0)
            TERM=linux
            ;;
        *)
            TERM=ansi
            # Line settings (baud/parity/bits), not just geometry below -
            # real hardware found (OVH/Kimsufi bare metal, IPMI Serial-
            # Over-LAN): an operator-chosen console (alpine-zfsboot.console=,
            # any of the three layers select_console() reads) that is NOT
            # the one embedded in CONSOLE_CMDLINE at build time (see
            # build.sh) was never touched by the kernel's own console=
            # parsing at all - console= is what makes the KERNEL configure
            # a given serial line's baud rate when it registers that line
            # as a console. A tty picked ONLY via this project's own
            # runtime preference layers sits at 9600n8 instead -
            # confirmed against the kernel's own serial_core.c
            # (uart_register_driver() hardcodes init_termios.c_cflag to
            # B9600|CS8|CREAD|HUPCL|CLOCAL for every line the kernel
            # itself never registered as a console), not merely "some
            # unpredictable default" - observed as complete silence, not
            # garbage, on a real IPMI SOL session attached to exactly
            # such a tty (a fixed-rate remote listener never frames
            # 9600-baud bytes correctly), which is a real, separate
            # problem from "wrong tty selected": the raw fd redirect above
            # is already correct and firmware/console=-independent (SOL
            # relays the physical UART, not "whatever the kernel calls a
            # console"), but bytes written at the wrong baud rate over a
            # real serial line are exactly as invisible to a fixed-rate
            # remote listener as if nothing had been sent at all. Setting
            # 115200n8 explicitly - the near-universal default for
            # IPMI/BMC SOL implementations (and what CONSOLE_CMDLINE
            # itself used to hardcode, back when it baked in a serial
            # console at all - see build.sh's own CONSOLE_CMDLINE
            # comment for why it no longer does) - makes an operator-
            # chosen console usable WITHOUT a hardware-specific rebuild:
            # one generic image, any real ttyS*/ttyAMA* an operator
            # names via the FAT config/cmdline layers just works,
            # matching the whole point of those layers existing at all.
            # A no-op, not a risk, on a tty that's already at this rate
            # (e.g. an explicit real kernel console=ttyS0,115200n8, via
            # EXTRA_CMDLINE or firmware LoadOptions, already configured
            # this way by the kernel's own console= handling).
            #
            # Not always 115200n8 unconditionally though - an operator
            # whose real hardware genuinely needs a different rate can
            # say so directly, in the value itself, the exact same
            # "ttySn,<baud><parity><bits>" shape the kernel's own
            # console= already uses (e.g.
            # alpine-zfsboot.console=ttyS1,9600n7) - ACTIVE_CONSOLE_OPTS
            # is whatever select_console() parsed out of that (empty for
            # a bare tty name, which is exactly when this still falls
            # back to 115200n8 - see _apply_console_line_settings's own
            # comment).
            _apply_console_line_settings "$ACTIVE_CONSOLE_OPTS"
            # A raw serial line carries NO terminal-geometry
            # negotiation of its own, at any layer - confirmed the
            # hard way on a real, reported "the TUI is corrupted"
            # boot, over a real multi-hop connection (a wide local
            # terminal emulator, through tmux, through ssh, through
            # `qm terminal`, to this exact serial line): none of those
            # hops carries real window-size information through to
            # this guest, so TIOCGWINSZ against this tty can report
            # 0x0, a stale leftover value, or anything else, with
            # nothing (no getty, no window-size negotiation the serial
            # protocol itself has no mechanism for at all) ever having
            # set a real one. dialog/ncurses computes its own cursor-
            # positioning escapes straight from whatever that ioctl
            # reports - a wrong size there is exactly what produced
            # the reported symptom (box-drawing running together,
            # lines starting at the wrong column, content overlapping
            # itself).
            #
            # The first fix attempt patched this per dialog call
            # instead (menu.py detecting TIOCGWINSZ itself, falling
            # back to 80x24, and forcing COLUMNS/LINES on each dialog
            # subprocess) - working, but the wrong layer: every single
            # caller had to remember to do it, and menu.py still had
            # no way to make a plain interactive shell (recovery_shell(),
            # chroot_be()) agree with dialog's own idea of the
            # terminal's size either. Fixing it ONCE here instead,
            # before ANYTHING (menu.py, dialog, an interactive shell)
            # ever queries this tty, means every single program
            # downstream sees the SAME correct answer from a plain,
            # unpatched TIOCGWINSZ - one authoritative console-init-
            # time decision instead of N per-caller guesses.
            #
            # Not an attempt to learn the REAL remote terminal's real
            # size (there is no way to, over a raw serial line - see
            # above) - a fixed, deterministic contract instead, the
            # same one a real serial getty's own default would
            # normally establish. tty0 (the branch above) needs no
            # equivalent: a real Linux virtual console's geometry
            # comes from the kernel's own vt/fbcon layer, which
            # genuinely knows its real size already.
            stty rows 24 cols 80 2>/dev/null
            ;;
    esac
    export TERM ALPINE_ZFSBOOT_ACTIVE_TTY="$ACTIVE_TTY" ALPINE_ZFSBOOT_ACTIVE_CONSOLE_OPTS="$ACTIVE_CONSOLE_OPTS"
    # A rescue-SSH session (dropbear wipes the environment) must still hand
    # the SAME decided console to the next kernel - see boot-dataset.sh.
    mkdir -p "$ROOTFS/tmp/alpine-zfsboot" 2>/dev/null
    printf '%s\n' "$ACTIVE_TTY" > "$ROOTFS/tmp/alpine-zfsboot/active-console" 2>/dev/null
    printf '%s\n' "$ACTIVE_CONSOLE_OPTS" > "$ROOTFS/tmp/alpine-zfsboot/active-console-opts" 2>/dev/null

    # Deliberately NOT `exec`: menu.py itself execs straight into
    # boot-dataset.sh on every path that actually boots something (see
    # menu.py's boot()), so running this in the foreground and letting
    # that happen costs nothing on the success path. The reason to
    # avoid exec here is the failure path: if python3/menu.py is
    # missing, OR python3 starts fine but then dies from an uncaught
    # exception (a real, repeated failure this project hit several
    # times in a row - missing stdlib modules under this deliberately
    # stripped-down interpreter), `exec` would already have replaced
    # init (PID 1) before that exception ever fires - and PID 1 exiting
    # for ANY reason, success or crash, is an unrecoverable kernel
    # panic ("Attempted to kill init!"), not a survivable error.
    # Running it as a plain child means a python-level crash just exits
    # that child with a nonzero status, PID 1 stays alive, and this
    # script falls through to the exact same automatic-boot safety net
    # already in place for the "not found" case - a menu.py bug now
    # costs a fallback to automatic boot, never a full reboot cycle.
    python3 /menu.py
    menu_rc=$?
    # 43: recovery_shell()'s own signal (see its own comment in
    # menu.py) - the operator was in there specifically because
    # POOL_IMPORT_ERROR was set, and may have just fixed the real
    # underlying problem by hand (the exact real case this exists for:
    # zpool labelclear on a stale ambiguous pool label, then a manual
    # zpool import). Re-running attempt_pool_import() here, before the
    # next python3 /menu.py, is what makes that fix actually visible
    # without a full reboot - menu.py re-reads
    # ALPINE_ZFSBOOT_POOL_IMPORT_ERROR (and BOOTFS/FORCED_RESCUE) fresh
    # from its own environment every time it's re-executed as a new
    # process, so re-exporting a genuinely fresh result here is the
    # whole fix; menu.py itself needed no change beyond deciding when
    # to ask for this.
    case "$menu_rc" in
        43) attempt_pool_import ;;
        *) break ;;
    esac
done
msg "menu.py exited (python3/menu.py missing or crashed) - falling back to automatic boot"

# menu.py itself is the normal way this situation surfaces now (see
# ALPINE_ZFSBOOT_POOL_IMPORT_ERROR above) - reaching this line at all with a
# real import error set means menu.py ALSO failed to even run (missing
# python3, an uncaught exception) with nothing left to boot anyway.
# The bare recovery shell here is the last resort, not the first
# thing anyone sees for an ordinary missing/broken pool anymore.
if [ -n "$ALPINE_ZFSBOOT_POOL_IMPORT_ERROR" ]; then
    die "$ALPINE_ZFSBOOT_POOL_IMPORT_ERROR"
fi

# Same reasoning as the POOL_IMPORT_ERROR check just above - if
# bootcheck's own decision point (see its own comment further up)
# determined this BE has exceeded its failed-boot threshold and rescue
# SSH is either up or explicitly forced, this fallback must never
# auto-boot it anyway just because menu.py happened to also crash.
if [ -n "$ALPINE_ZFSBOOT_FORCED_RESCUE" ]; then
    die "$ALPINE_ZFSBOOT_FORCED_RESCUE"
fi

exec /boot-dataset.sh "$BOOTFS" "$POOL"
die "unreachable - /boot-dataset.sh should never return"
